#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* inputAddr, __ubuf__ float* outputAddr,
                                    __ubuf__ int32_t* expertIdxAddr, __ubuf__ float* outAddr) {
    uint32_t rowsInBatchU32 = 3072;
    uint16_t vfLoopNum = 48;
    constexpr uint32_t VL_FLOAT_SIZE = 64;
    constexpr float LOG1P_TAYLOR_THRESHOLD = 0.00390625f;
    float eps_ = 9.999999747378752e-05f, routedScalingFactor_ = 1.25f;
    __VEC_SCOPE__ {
        vector_f32 vregIn;
        vector_f32 vregNorm;
        vector_f32 vregOut;
        vector_f32 vregSumBcast;
        vector_f32 vregAbsX;
        vector_f32 vregApprox;
        vector_f32 vregHalfT;
        vector_f32 vregOneMinusHalfT;
        vector_f32 vregOne;
        vector_f32 vregZero;
        vector_f32 vregTmp1;
        vector_f32 vregTmp2;
        vector_f32 vregTmp3;
        vector_s32 vregZeroIdx;
        vector_bool preg0 = pset_b32(PAT_ALL);
        vector_bool pregCmp = pset_b32(PAT_ALL);
        vdup(vregOne, static_cast<float>(1), preg0, MODE_ZEROING);
        vdup(vregZero, static_cast<float>(0), preg0, MODE_ZEROING);

#pragma unroll 1

        for (uint16_t i = 0; i < vfLoopNum; i++) {
            preg0 = plt_b32(rowsInBatchU32, POST_UPDATE);
            vlds(vregIn, inputAddr + (i * VL_FLOAT_SIZE), 0, NORM);

            vabs(vregAbsX, vregIn, preg0, MODE_ZEROING);
            vmuls(vregTmp1, vregAbsX, static_cast<float>(-1), preg0, MODE_ZEROING);
            vexp(vregTmp1, vregTmp1, preg0, MODE_ZEROING);
            vcmps_lt(pregCmp, vregTmp1, LOG1P_TAYLOR_THRESHOLD, preg0);
            vmuls(vregHalfT, vregTmp1, static_cast<float>(0.5), preg0, MODE_ZEROING);
            vsub(vregOneMinusHalfT, vregOne, vregHalfT, preg0, MODE_ZEROING);
            vmul(vregApprox, vregTmp1, vregOneMinusHalfT, preg0, MODE_ZEROING);
            vadds(vregTmp2, vregTmp1, static_cast<float>(1), preg0, MODE_ZEROING);
            vln(vregTmp3, vregTmp2, preg0, MODE_ZEROING);
            vsel(vregTmp3, vregApprox, vregTmp3, pregCmp);
            vmax(vregTmp1, vregIn, vregZero, preg0, MODE_ZEROING);
            vadd(vregNorm, vregTmp1, vregTmp3, preg0, MODE_ZEROING);
            vsqrt(vregNorm, vregNorm, preg0, MODE_ZEROING);
            vadds(vregSumBcast, vregNorm, eps_, preg0, MODE_ZEROING);
            vdiv(vregOut, vregNorm, vregSumBcast, preg0, MODE_ZEROING);
            vmuls(vregOut, vregOut, routedScalingFactor_, preg0, MODE_ZEROING);
            vdup(vregZeroIdx, static_cast<int32_t>(0), preg0, MODE_ZEROING);
            vsts(vregOut, outputAddr + (i * VL_FLOAT_SIZE), 0, NORM_B32, preg0);
            vsts(vregZeroIdx, expertIdxAddr + i * VL_FLOAT_SIZE, 0, NORM_B32, preg0);
            vsts(vregNorm, outAddr + i * VL_FLOAT_SIZE, 0, NORM_B32, preg0);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* inputAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* outputAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ int32_t* expertIdxAddr = (__ubuf__ int32_t*)get_imm(24576);
    __ubuf__ float* outAddr = (__ubuf__ float*)get_imm(36864);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12288, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(inputAddr, outputAddr, expertIdxAddr, outAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)outputAddr, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)expertIdxAddr, 0, 1, 12288, 0, 0,
                             0);
    copy_ubuf_to_gm_align_v2(output + 24576, (__ubuf__ uint8_t*)outAddr, 0, 1, 12288, 0, 0, 0);
}
