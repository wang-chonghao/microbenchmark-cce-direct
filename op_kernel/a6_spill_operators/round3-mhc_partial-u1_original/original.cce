#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* mmPartial, __ubuf__ float* rmsPartial,
                                    __ubuf__ float* mmOut, __ubuf__ float* invRmsOut) {
    uint16_t rowCount = 48, fusionSize = 64, mmSegmentOffset = 0, mmSegmentSize = 64,
             rmsStride = 48, fourLoopCount = 1, tailLoopCount = 0;
    uint32_t mmGroupStride = 3072;
    float scaleMean = 0.25f, normEps = 1e-5f;
    __VEC_SCOPE__ {
        vector_f32 rms0;
        vector_f32 rms1;
        vector_f32 rms2;
        vector_f32 rms3;
        vector_f32 mm0;
        vector_f32 mm1;
        vector_f32 mm2;
        vector_f32 mm3;
        vector_f32 sumRms0;
        vector_f32 sumRms1;
        vector_f32 sumRms2;
        vector_f32 sumRms3;
        vector_f32 sumMm0;
        vector_f32 sumMm1;
        vector_f32 sumMm2;
        vector_f32 sumMm3;
        vector_f32 one;
        uint32_t rmsMaskSize = 1U;
        uint32_t mmMaskSize = mmSegmentSize;
        vector_bool rmsMask = plt_b32(rmsMaskSize, POST_UPDATE);
        vector_bool mmMask = plt_b32(mmMaskSize, POST_UPDATE);
        vdup(one, 1.0f, rmsMask, MODE_ZEROING);

#pragma unroll 1

        for (uint16_t row = 0; row < rowCount; ++row) {
            vdup(sumRms0, 0.0f, rmsMask, MODE_ZEROING);
            vdup(sumRms1, 0.0f, rmsMask, MODE_ZEROING);
            vdup(sumRms2, 0.0f, rmsMask, MODE_ZEROING);
            vdup(sumRms3, 0.0f, rmsMask, MODE_ZEROING);
            vdup(sumMm0, 0.0f, mmMask, MODE_ZEROING);
            vdup(sumMm1, 0.0f, mmMask, MODE_ZEROING);
            vdup(sumMm2, 0.0f, mmMask, MODE_ZEROING);
            vdup(sumMm3, 0.0f, mmMask, MODE_ZEROING);

#pragma unroll 1

            for (uint16_t loop = 0; loop < fourLoopCount; ++loop) {
                uint16_t kBase = loop * 4U;
                vlds(rms0, rmsPartial + (static_cast<uint32_t>(kBase) * rmsStride + row), 0,
                     BRC_B32);
                vlds(rms1, rmsPartial + (static_cast<uint32_t>(kBase + 1U) * rmsStride + row), 0,
                     BRC_B32);
                vlds(rms2, rmsPartial + (static_cast<uint32_t>(kBase + 2U) * rmsStride + row), 0,
                     BRC_B32);
                vlds(rms3, rmsPartial + (static_cast<uint32_t>(kBase + 3U) * rmsStride + row), 0,
                     BRC_B32);
                vadd(sumRms0, sumRms0, rms0, rmsMask, MODE_ZEROING);
                vadd(sumRms1, sumRms1, rms1, rmsMask, MODE_ZEROING);
                vadd(sumRms2, sumRms2, rms2, rmsMask, MODE_ZEROING);
                vadd(sumRms3, sumRms3, rms3, rmsMask, MODE_ZEROING);

                {
                    __ubuf__ int32_t* cce_load_1_ptr =
                        (__ubuf__ int32_t*)(mmPartial +
                                            static_cast<uint32_t>(kBase) * mmGroupStride +
                                            row * fusionSize + mmSegmentOffset);
                    vector_align cce_load_1_align;
                    vldas(cce_load_1_align, cce_load_1_ptr);
                    vldus((vector_s32&)mm0, cce_load_1_align, cce_load_1_ptr);
                };
                {
                    __ubuf__ int32_t* cce_load_2_ptr =
                        (__ubuf__ int32_t*)(mmPartial +
                                            static_cast<uint32_t>(kBase + 1U) * mmGroupStride +
                                            row * fusionSize + mmSegmentOffset);
                    vector_align cce_load_2_align;
                    vldas(cce_load_2_align, cce_load_2_ptr);
                    vldus((vector_s32&)mm1, cce_load_2_align, cce_load_2_ptr);
                };
                {
                    __ubuf__ int32_t* cce_load_3_ptr =
                        (__ubuf__ int32_t*)(mmPartial +
                                            static_cast<uint32_t>(kBase + 2U) * mmGroupStride +
                                            row * fusionSize + mmSegmentOffset);
                    vector_align cce_load_3_align;
                    vldas(cce_load_3_align, cce_load_3_ptr);
                    vldus((vector_s32&)mm2, cce_load_3_align, cce_load_3_ptr);
                };
                {
                    __ubuf__ int32_t* cce_load_4_ptr =
                        (__ubuf__ int32_t*)(mmPartial +
                                            static_cast<uint32_t>(kBase + 3U) * mmGroupStride +
                                            row * fusionSize + mmSegmentOffset);
                    vector_align cce_load_4_align;
                    vldas(cce_load_4_align, cce_load_4_ptr);
                    vldus((vector_s32&)mm3, cce_load_4_align, cce_load_4_ptr);
                };
                vadd(sumMm0, sumMm0, mm0, mmMask, MODE_ZEROING);
                vadd(sumMm1, sumMm1, mm1, mmMask, MODE_ZEROING);
                vadd(sumMm2, sumMm2, mm2, mmMask, MODE_ZEROING);
                vadd(sumMm3, sumMm3, mm3, mmMask, MODE_ZEROING);
            }

#pragma unroll 1

            for (uint16_t tail = 0; tail < tailLoopCount; ++tail) {
                uint16_t kIndex = fourLoopCount * 4U + tail;
                vlds(rms0, rmsPartial + (static_cast<uint32_t>(kIndex) * rmsStride + row), 0,
                     BRC_B32);
                vadd(sumRms0, sumRms0, rms0, rmsMask, MODE_ZEROING);
                {
                    __ubuf__ int32_t* cce_load_5_ptr =
                        (__ubuf__ int32_t*)(mmPartial +
                                            static_cast<uint32_t>(kIndex) * mmGroupStride +
                                            row * fusionSize + mmSegmentOffset);
                    vector_align cce_load_5_align;
                    vldas(cce_load_5_align, cce_load_5_ptr);
                    vldus((vector_s32&)mm0, cce_load_5_align, cce_load_5_ptr);
                };
                vadd(sumMm0, sumMm0, mm0, mmMask, MODE_ZEROING);
            }

            vadd(sumRms0, sumRms0, sumRms3, rmsMask, MODE_ZEROING);
            vadd(sumRms1, sumRms1, sumRms2, rmsMask, MODE_ZEROING);
            vadd(sumRms0, sumRms0, sumRms1, rmsMask, MODE_ZEROING);
            vmuls(sumRms0, sumRms0, scaleMean, rmsMask, MODE_ZEROING);
            vadds(sumRms0, sumRms0, normEps, rmsMask, MODE_ZEROING);
            vsqrt(sumRms0, sumRms0, rmsMask, MODE_ZEROING);
            vdiv(sumRms0, one, sumRms0, rmsMask, MODE_ZEROING);

            vadd(sumMm0, sumMm0, sumMm3, mmMask, MODE_ZEROING);
            vadd(sumMm1, sumMm1, sumMm2, mmMask, MODE_ZEROING);
            vadd(sumMm0, sumMm0, sumMm1, mmMask, MODE_ZEROING);
            {
                __ubuf__ int32_t* cce_store_6_ptr = (__ubuf__ int32_t*)(invRmsOut + row);
                vector_align cce_store_6_align;
                vstus(cce_store_6_align, 1U, (vector_s32&)sumRms0, cce_store_6_ptr, POST_UPDATE);
                vstas(cce_store_6_align, cce_store_6_ptr, 0, POST_UPDATE);
            };
            {
                __ubuf__ int32_t* cce_store_7_ptr =
                    (__ubuf__ int32_t*)(mmOut + row * fusionSize + mmSegmentOffset);
                vector_align cce_store_7_align;
                vstus(cce_store_7_align, mmSegmentSize, (vector_s32&)sumMm0, cce_store_7_ptr,
                      POST_UPDATE);
                vstas(cce_store_7_align, cce_store_7_ptr, 0, POST_UPDATE);
            };
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* mmPartial = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* rmsPartial = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* mmOut = (__ubuf__ float*)get_imm(49920);
    __ubuf__ float* invRmsOut = (__ubuf__ float*)get_imm(62208);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 49920, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(mmPartial, rmsPartial, mmOut, invRmsOut);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)mmOut, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)invRmsOut, 0, 1, 192, 0, 0, 0);
}
