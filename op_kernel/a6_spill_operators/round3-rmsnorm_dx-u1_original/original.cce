#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* gammaAddr, __ubuf__ float* dyAddr,
                                    __ubuf__ float* xAddr, __ubuf__ float* rstdAddr,
                                    __ubuf__ float* meanAddr, __ubuf__ float* dxAddr) {
    uint32_t sreg = 3072;
    constexpr uint32_t oneRepeat = 64;
    uint16_t repeatCount = 48;
    __VEC_SCOPE__ {
        vector_f32 gammaReg, dyReg, xReg, rstdReg, meanReg, dxReg, mulReg0, mulReg2, mulReg4,
            subReg;
        vector_bool maskReg;
        vlds(rstdReg, rstdAddr, 0, BRC_B32);
        vlds(meanReg, meanAddr, 0, BRC_B32);
#pragma unroll 1
        for (uint16_t i = 0; i < repeatCount; i++) {
            maskReg = plt_b32(sreg, POST_UPDATE);
            vlds(gammaReg, gammaAddr + (i * oneRepeat), 0, NORM);
            vlds(dyReg, dyAddr + (i * oneRepeat), 0, NORM);
            vmul(mulReg2, dyReg, gammaReg, maskReg, MODE_ZEROING);
            vlds(xReg, xAddr + (i * oneRepeat), 0, NORM);
            vmul(mulReg0, xReg, rstdReg, maskReg, MODE_ZEROING);
            vmul(mulReg4, mulReg0, meanReg, maskReg, MODE_ZEROING);
            vsub(subReg, mulReg2, mulReg4, maskReg, MODE_ZEROING);
            vmul(dxReg, subReg, rstdReg, maskReg, MODE_ZEROING);

            vsts(dxReg, dxAddr + static_cast<uint32_t>(i * oneRepeat), 0, NORM_B32, maskReg);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* gammaAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dyAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* rstdAddr = (__ubuf__ float*)get_imm(36864);
    __ubuf__ float* meanAddr = (__ubuf__ float*)get_imm(37120);
    __ubuf__ float* dxAddr = (__ubuf__ float*)get_imm(37376);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 37376, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(gammaAddr, dyAddr, xAddr, rstdAddr, meanAddr, dxAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dxAddr, 0, 1, 12288, 0, 0, 0);
}
