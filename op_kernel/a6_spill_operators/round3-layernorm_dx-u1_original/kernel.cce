// MB_KERNEL candidate_kernel
// MB_TENSOR input input uint8 25600
// MB_TENSOR output output uint8 12288
// A6 wrapper migration only; original VF below is unchanged.
#ifndef __local_mem__
#define __local_mem__ __ubuf__
#endif
