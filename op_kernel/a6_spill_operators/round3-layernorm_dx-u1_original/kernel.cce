#include <stdint.h>
#ifndef __aicore__
#define __aicore__ [aicore]
#endif
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* dy, __ubuf__ float* x, __ubuf__ float* gamma,
                                    __ubuf__ float* sum1, __ubuf__ float* sum2,
                                    __ubuf__ float* rstd, __ubuf__ float* dst) {
    uint16_t outerLoopTimes = 48;
    uint32_t colSize = 64, outerLoopStride = 64, innerLoopStride = 64;
    float floatN = 64.0f, reciprocalN = 0.015625f;
    __VEC_SCOPE__ {

        uint32_t count;

        vector_f32 xReg, dyReg, dxReg;
        vector_f32 sum1Reg, sum2Reg, rstdReg;
        vector_f32 gammaReg;
        vector_f32 Reg0, Reg1, Reg2, Reg3, Reg4, Reg5;
        vector_bool pMask;
        count = static_cast<uint32_t>(colSize);
        pMask = plt_b32(count, POST_UPDATE);
#pragma unroll 1
        for (uint16_t i = 0; i < outerLoopTimes; ++i) {
            vlds(sum1Reg, (__local_mem__ float*)sum1 + i, 0, BRC_B32);
            vlds(sum2Reg, (__local_mem__ float*)sum2 + i, 0, BRC_B32);
            vlds(rstdReg, (__local_mem__ float*)rstd + i, 0, BRC_B32);
            vlds(dyReg, (__local_mem__ float*)dy + i * outerLoopStride + 0 * innerLoopStride, 0,
                 NORM);
            vlds(xReg, (__local_mem__ float*)x + i * outerLoopStride + 0 * innerLoopStride, 0,
                 NORM);
            vlds(gammaReg, (__local_mem__ float*)gamma + 0 * innerLoopStride, 0, NORM);
            vmul(Reg0, dyReg, gammaReg, pMask, MODE_ZEROING);
            vmuls(Reg1, Reg0, floatN, pMask, MODE_ZEROING);
            vsub(Reg2, Reg1, sum1Reg, pMask, MODE_ZEROING);
            vmul(Reg3, xReg, sum2Reg, pMask, MODE_ZEROING);
            vsub(Reg4, Reg2, Reg3, pMask, MODE_ZEROING);
            vmuls(Reg5, Reg4, reciprocalN, pMask, MODE_ZEROING);
            vmul(dxReg, Reg5, rstdReg, pMask, MODE_ZEROING);
            vsts(dxReg, dst + (i * outerLoopStride), 0, NORM_B32, pMask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* dy = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* x = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* gamma = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* sum1 = (__ubuf__ float*)get_imm(24832);
    __ubuf__ float* sum2 = (__ubuf__ float*)get_imm(25088);
    __ubuf__ float* rstd = (__ubuf__ float*)get_imm(25344);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(25600);
    nddma_desc a6_desc(nddma_desc::loop_desc(6400, 1, 1));
    nddma_out_to_ub((__ubuf__ uint32_t*)get_imm(0), (__gm__ uint32_t*)input, 0, a6_desc, 0, NEAREST_PADDING, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(dy, x, gamma, sum1, sum2, rstd, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    pipe_barrier(PIPE_ALL);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    __ubuf__ uint32_t* a6_offsets = (__ubuf__ uint32_t*)get_imm(0);
    a6_offsets[0] = 0;
    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    scatter_ubuf_to_gm((__gm__ uint32_t*)(output + 0), (__ubuf__ uint32_t*)dst, 0, 0, a6_offsets, 0, 12288, 0, 1);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
