#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* gammaAddr, __ubuf__ float* dyAddr,
                                    __ubuf__ float* xAddr, __ubuf__ float* rstdAddr,
                                    __ubuf__ float* meanAddr, __ubuf__ float* dxAddr) {
    uint32_t sreg = 3072;
    constexpr uint32_t oneRepeat = 64;
    uint16_t repeatCount = 48;
    __VEC_SCOPE__ {
        vector_f32 gammaReg, dyReg, xReg, rstdReg, meanReg, dxReg, mulReg0, mulReg2, mulReg4,
            subReg;
        vector_bool maskReg;
        vlds(rstdReg, rstdAddr, 0, BRC_B32);
        vlds(meanReg, meanAddr, 0, BRC_B32);
        {
            vector_f32 dxReg_u0;
            vector_f32 dxReg_u1;
            vector_f32 dxReg_u2;
            vector_f32 dxReg_u3;
            vector_f32 dxReg_u4;
            vector_f32 dxReg_u5;
            vector_f32 dxReg_u6;
            vector_f32 dxReg_u7;
            vector_f32 dyReg_u0;
            vector_f32 dyReg_u1;
            vector_f32 dyReg_u2;
            vector_f32 dyReg_u3;
            vector_f32 dyReg_u4;
            vector_f32 dyReg_u5;
            vector_f32 dyReg_u6;
            vector_f32 dyReg_u7;
            vector_f32 gammaReg_u0;
            vector_f32 gammaReg_u1;
            vector_f32 gammaReg_u2;
            vector_f32 gammaReg_u3;
            vector_f32 gammaReg_u4;
            vector_f32 gammaReg_u5;
            vector_f32 gammaReg_u6;
            vector_f32 gammaReg_u7;
            vector_bool maskReg_u0;
            vector_bool maskReg_u1;
            vector_bool maskReg_u2;
            vector_bool maskReg_u3;
            vector_bool maskReg_u4;
            vector_bool maskReg_u5;
            vector_bool maskReg_u6;
            vector_bool maskReg_u7;
            vector_f32 mulReg0_u0;
            vector_f32 mulReg0_u1;
            vector_f32 mulReg0_u2;
            vector_f32 mulReg0_u3;
            vector_f32 mulReg0_u4;
            vector_f32 mulReg0_u5;
            vector_f32 mulReg0_u6;
            vector_f32 mulReg0_u7;
            vector_f32 mulReg2_u0;
            vector_f32 mulReg2_u1;
            vector_f32 mulReg2_u2;
            vector_f32 mulReg2_u3;
            vector_f32 mulReg2_u4;
            vector_f32 mulReg2_u5;
            vector_f32 mulReg2_u6;
            vector_f32 mulReg2_u7;
            vector_f32 mulReg4_u0;
            vector_f32 mulReg4_u1;
            vector_f32 mulReg4_u2;
            vector_f32 mulReg4_u3;
            vector_f32 mulReg4_u4;
            vector_f32 mulReg4_u5;
            vector_f32 mulReg4_u6;
            vector_f32 mulReg4_u7;
            vector_f32 subReg_u0;
            vector_f32 subReg_u1;
            vector_f32 subReg_u2;
            vector_f32 subReg_u3;
            vector_f32 subReg_u4;
            vector_f32 subReg_u5;
            vector_f32 subReg_u6;
            vector_f32 subReg_u7;
            vector_f32 xReg_u0;
            vector_f32 xReg_u1;
            vector_f32 xReg_u2;
            vector_f32 xReg_u3;
            vector_f32 xReg_u4;
            vector_f32 xReg_u5;
            vector_f32 xReg_u6;
            vector_f32 xReg_u7;
#pragma unroll 1
            for (uint32_t i = 0; i < 48; i += 8) {
                maskReg_u0 = plt_b32(sreg, POST_UPDATE);
                maskReg_u1 = plt_b32(sreg, POST_UPDATE);
                maskReg_u2 = plt_b32(sreg, POST_UPDATE);
                maskReg_u3 = plt_b32(sreg, POST_UPDATE);
                maskReg_u4 = plt_b32(sreg, POST_UPDATE);
                maskReg_u5 = plt_b32(sreg, POST_UPDATE);
                maskReg_u6 = plt_b32(sreg, POST_UPDATE);
                maskReg_u7 = plt_b32(sreg, POST_UPDATE);
                vlds(gammaReg_u0, gammaAddr + ((i + 0) * oneRepeat), 0, NORM);
                vlds(gammaReg_u1, gammaAddr + ((i + 1) * oneRepeat), 0, NORM);
                vlds(gammaReg_u2, gammaAddr + ((i + 2) * oneRepeat), 0, NORM);
                vlds(gammaReg_u3, gammaAddr + ((i + 3) * oneRepeat), 0, NORM);
                vlds(gammaReg_u4, gammaAddr + ((i + 4) * oneRepeat), 0, NORM);
                vlds(gammaReg_u5, gammaAddr + ((i + 5) * oneRepeat), 0, NORM);
                vlds(gammaReg_u6, gammaAddr + ((i + 6) * oneRepeat), 0, NORM);
                vlds(gammaReg_u7, gammaAddr + ((i + 7) * oneRepeat), 0, NORM);
                vlds(dyReg_u0, dyAddr + ((i + 0) * oneRepeat), 0, NORM);
                vlds(dyReg_u1, dyAddr + ((i + 1) * oneRepeat), 0, NORM);
                vlds(dyReg_u2, dyAddr + ((i + 2) * oneRepeat), 0, NORM);
                vlds(dyReg_u3, dyAddr + ((i + 3) * oneRepeat), 0, NORM);
                vlds(dyReg_u4, dyAddr + ((i + 4) * oneRepeat), 0, NORM);
                vlds(dyReg_u5, dyAddr + ((i + 5) * oneRepeat), 0, NORM);
                vlds(dyReg_u6, dyAddr + ((i + 6) * oneRepeat), 0, NORM);
                vlds(dyReg_u7, dyAddr + ((i + 7) * oneRepeat), 0, NORM);
                vmul(mulReg2_u0, dyReg_u0, gammaReg_u0, maskReg_u0, MODE_ZEROING);
                vmul(mulReg2_u1, dyReg_u1, gammaReg_u1, maskReg_u1, MODE_ZEROING);
                vmul(mulReg2_u2, dyReg_u2, gammaReg_u2, maskReg_u2, MODE_ZEROING);
                vmul(mulReg2_u3, dyReg_u3, gammaReg_u3, maskReg_u3, MODE_ZEROING);
                vmul(mulReg2_u4, dyReg_u4, gammaReg_u4, maskReg_u4, MODE_ZEROING);
                vmul(mulReg2_u5, dyReg_u5, gammaReg_u5, maskReg_u5, MODE_ZEROING);
                vmul(mulReg2_u6, dyReg_u6, gammaReg_u6, maskReg_u6, MODE_ZEROING);
                vmul(mulReg2_u7, dyReg_u7, gammaReg_u7, maskReg_u7, MODE_ZEROING);
                vlds(xReg_u0, xAddr + ((i + 0) * oneRepeat), 0, NORM);
                vlds(xReg_u1, xAddr + ((i + 1) * oneRepeat), 0, NORM);
                vlds(xReg_u2, xAddr + ((i + 2) * oneRepeat), 0, NORM);
                vlds(xReg_u3, xAddr + ((i + 3) * oneRepeat), 0, NORM);
                vlds(xReg_u4, xAddr + ((i + 4) * oneRepeat), 0, NORM);
                vlds(xReg_u5, xAddr + ((i + 5) * oneRepeat), 0, NORM);
                vlds(xReg_u6, xAddr + ((i + 6) * oneRepeat), 0, NORM);
                vlds(xReg_u7, xAddr + ((i + 7) * oneRepeat), 0, NORM);
                vmul(mulReg0_u0, xReg_u0, rstdReg, maskReg_u0, MODE_ZEROING);
                vmul(mulReg0_u1, xReg_u1, rstdReg, maskReg_u1, MODE_ZEROING);
                vmul(mulReg0_u2, xReg_u2, rstdReg, maskReg_u2, MODE_ZEROING);
                vmul(mulReg0_u3, xReg_u3, rstdReg, maskReg_u3, MODE_ZEROING);
                vmul(mulReg0_u4, xReg_u4, rstdReg, maskReg_u4, MODE_ZEROING);
                vmul(mulReg0_u5, xReg_u5, rstdReg, maskReg_u5, MODE_ZEROING);
                vmul(mulReg0_u6, xReg_u6, rstdReg, maskReg_u6, MODE_ZEROING);
                vmul(mulReg0_u7, xReg_u7, rstdReg, maskReg_u7, MODE_ZEROING);
                vmul(mulReg4_u0, mulReg0_u0, meanReg, maskReg_u0, MODE_ZEROING);
                vmul(mulReg4_u1, mulReg0_u1, meanReg, maskReg_u1, MODE_ZEROING);
                vmul(mulReg4_u2, mulReg0_u2, meanReg, maskReg_u2, MODE_ZEROING);
                vmul(mulReg4_u3, mulReg0_u3, meanReg, maskReg_u3, MODE_ZEROING);
                vmul(mulReg4_u4, mulReg0_u4, meanReg, maskReg_u4, MODE_ZEROING);
                vmul(mulReg4_u5, mulReg0_u5, meanReg, maskReg_u5, MODE_ZEROING);
                vmul(mulReg4_u6, mulReg0_u6, meanReg, maskReg_u6, MODE_ZEROING);
                vmul(mulReg4_u7, mulReg0_u7, meanReg, maskReg_u7, MODE_ZEROING);
                vsub(subReg_u0, mulReg2_u0, mulReg4_u0, maskReg_u0, MODE_ZEROING);
                vsub(subReg_u1, mulReg2_u1, mulReg4_u1, maskReg_u1, MODE_ZEROING);
                vsub(subReg_u2, mulReg2_u2, mulReg4_u2, maskReg_u2, MODE_ZEROING);
                vsub(subReg_u3, mulReg2_u3, mulReg4_u3, maskReg_u3, MODE_ZEROING);
                vsub(subReg_u4, mulReg2_u4, mulReg4_u4, maskReg_u4, MODE_ZEROING);
                vsub(subReg_u5, mulReg2_u5, mulReg4_u5, maskReg_u5, MODE_ZEROING);
                vsub(subReg_u6, mulReg2_u6, mulReg4_u6, maskReg_u6, MODE_ZEROING);
                vsub(subReg_u7, mulReg2_u7, mulReg4_u7, maskReg_u7, MODE_ZEROING);
                vmul(dxReg_u0, subReg_u0, rstdReg, maskReg_u0, MODE_ZEROING);
                vmul(dxReg_u1, subReg_u1, rstdReg, maskReg_u1, MODE_ZEROING);
                vmul(dxReg_u2, subReg_u2, rstdReg, maskReg_u2, MODE_ZEROING);
                vmul(dxReg_u3, subReg_u3, rstdReg, maskReg_u3, MODE_ZEROING);
                vmul(dxReg_u4, subReg_u4, rstdReg, maskReg_u4, MODE_ZEROING);
                vmul(dxReg_u5, subReg_u5, rstdReg, maskReg_u5, MODE_ZEROING);
                vmul(dxReg_u6, subReg_u6, rstdReg, maskReg_u6, MODE_ZEROING);
                vmul(dxReg_u7, subReg_u7, rstdReg, maskReg_u7, MODE_ZEROING);
                vsts(dxReg_u0, dxAddr + static_cast<uint32_t>((i + 0) * oneRepeat), 0, NORM_B32,
                     maskReg_u0);
                vsts(dxReg_u1, dxAddr + static_cast<uint32_t>((i + 1) * oneRepeat), 0, NORM_B32,
                     maskReg_u1);
                vsts(dxReg_u2, dxAddr + static_cast<uint32_t>((i + 2) * oneRepeat), 0, NORM_B32,
                     maskReg_u2);
                vsts(dxReg_u3, dxAddr + static_cast<uint32_t>((i + 3) * oneRepeat), 0, NORM_B32,
                     maskReg_u3);
                vsts(dxReg_u4, dxAddr + static_cast<uint32_t>((i + 4) * oneRepeat), 0, NORM_B32,
                     maskReg_u4);
                vsts(dxReg_u5, dxAddr + static_cast<uint32_t>((i + 5) * oneRepeat), 0, NORM_B32,
                     maskReg_u5);
                vsts(dxReg_u6, dxAddr + static_cast<uint32_t>((i + 6) * oneRepeat), 0, NORM_B32,
                     maskReg_u6);
                vsts(dxReg_u7, dxAddr + static_cast<uint32_t>((i + 7) * oneRepeat), 0, NORM_B32,
                     maskReg_u7);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* gammaAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dyAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* rstdAddr = (__ubuf__ float*)get_imm(36864);
    __ubuf__ float* meanAddr = (__ubuf__ float*)get_imm(37120);
    __ubuf__ float* dxAddr = (__ubuf__ float*)get_imm(37376);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 37376, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(gammaAddr, dyAddr, xAddr, rstdAddr, meanAddr, dxAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dxAddr, 0, 1, 12288, 0, 0, 0);
}
