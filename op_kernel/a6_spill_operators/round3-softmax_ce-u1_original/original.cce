#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* inputUbAddr, __ubuf__ float* labelsUbAddr,
                                    __ubuf__ float* maxUbAddr, __ubuf__ float* sumUbAddr,
                                    __ubuf__ float* logUbAddr, __ubuf__ float* outUbAddr,
                                    __ubuf__ float* backProbAddr) {
    uint16_t nTimes = 48, repeatTimes1 = 1, tailLoopTimes = 0;
    uint32_t vfLen = 64, rOnceNumTAlign = 64, rOnceNumAlign = 64, tailNum = 0;
    __VEC_SCOPE__ {
        vector_bool copyOutReg = pset_b32(PAT_ALL);
        vector_f32 maxReg;
        vector_f32 sumReg;
        vector_f32 logReg;
        vector_f32 srcReg0;
        vector_f32 srcReg1;
        vector_f32 srcRegfp32;
        vector_f32 srcReg1fp32;
        vector_f32 subReg;
        vector_f32 expReg;
        vector_f32 tmpReg;

        vector_f32 outReg;
        vector_f32 outReg1;
        vector_f32 backPropReg;
        vector_bool preg = plt_b32(tailNum, POST_UPDATE);
#pragma unroll 1
        for (uint16_t i = 0; i < nTimes; i++) {
            vlds(maxReg, maxUbAddr + i, 0, BRC_B32);
            vlds(sumReg, sumUbAddr + i, 0, BRC_B32);
            vlds(logReg, logUbAddr + i, 0, BRC_B32);
#pragma unroll 1
            for (uint16_t j = 0; j < repeatTimes1; j++) {
                uint32_t srcOffset = ((i) * (rOnceNumTAlign) + (j) * (vfLen));
                uint32_t outOffset = ((i) * (rOnceNumAlign) + (j) * (vfLen));

                vlds(srcRegfp32, inputUbAddr, srcOffset, NORM);
                vlds(srcReg1fp32, labelsUbAddr, srcOffset, NORM);

                vsub(subReg, srcRegfp32, maxReg, copyOutReg, MODE_ZEROING);
                vexp(expReg, subReg, copyOutReg, MODE_ZEROING);
                vdiv(expReg, expReg, sumReg, copyOutReg, MODE_ZEROING);
                vsub(expReg, expReg, srcReg1fp32, copyOutReg, MODE_ZEROING);
                vsub(tmpReg, logReg, subReg, copyOutReg, MODE_ZEROING);
                vmul(tmpReg, tmpReg, srcReg1fp32, copyOutReg, MODE_ZEROING);
                vlds(outReg, outUbAddr, outOffset, NORM);
                vadd(outReg1, tmpReg, outReg, copyOutReg, MODE_ZEROING);
                vsts(outReg1, outUbAddr, outOffset, NORM_B32, copyOutReg);

                vsts(expReg, backProbAddr, srcOffset, NORM_B32, copyOutReg);
            }
#pragma unroll 1
            for (uint16_t k = 0; k < tailLoopTimes; k++) {

                vlds(srcRegfp32, inputUbAddr + i * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);
                vlds(srcReg1fp32, labelsUbAddr + i * rOnceNumTAlign + repeatTimes1 * vfLen, 0,
                     NORM);

                vsub(subReg, srcRegfp32, maxReg, preg, MODE_ZEROING);
                vexp(expReg, subReg, preg, MODE_ZEROING);
                vdiv(expReg, expReg, sumReg, preg, MODE_ZEROING);
                vsub(expReg, expReg, srcReg1fp32, preg, MODE_ZEROING);
                vsub(logReg, logReg, subReg, preg, MODE_ZEROING);
                vmul(logReg, logReg, srcReg1fp32, preg, MODE_ZEROING);
                vlds(outReg, outUbAddr + i * rOnceNumAlign + repeatTimes1 * vfLen, 0, NORM);
                vadd(outReg1, logReg, outReg, preg, MODE_ZEROING);
                vsts(outReg1, outUbAddr + i * rOnceNumAlign + repeatTimes1 * vfLen, 0, NORM_B32,
                     preg);

                vsts(expReg, backProbAddr + i * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM_B32,
                     preg);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* inputUbAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* labelsUbAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* maxUbAddr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* sumUbAddr = (__ubuf__ float*)get_imm(24832);
    __ubuf__ float* logUbAddr = (__ubuf__ float*)get_imm(25088);
    __ubuf__ float* outUbAddr = (__ubuf__ float*)get_imm(25344);
    __ubuf__ float* backProbAddr = (__ubuf__ float*)get_imm(37632);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 37632, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(inputUbAddr, labelsUbAddr, maxUbAddr, sumUbAddr, logUbAddr, outUbAddr,
                 backProbAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)outUbAddr, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)backProbAddr, 0, 1, 12288, 0, 0, 0);
}
