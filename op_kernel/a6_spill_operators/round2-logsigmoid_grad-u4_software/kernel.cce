r0 = pset_b32(PAT_ALL);
vdup(r1, 0x1.0000000000000p+0f, r0, MODE_ZEROING);
vdup(r2, 0x0.0p+0f, r0, MODE_ZEROING);
uint32_t mask_remaining_s0_0 = 3072;
#pragma unroll 1
        for (uint16_t iter_s0_0 = 0; iter_s0_0 < 12; ++iter_s0_0) {
vlds(r5, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 0))), 0, NORM);
vlds(r16, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 1))), 0, NORM);
vlds(r27, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 2))), 0, NORM);
vlds(r38, (__ubuf__ float*)(arena + (12288 + 256 * (0 + 4 * iter_s0_0 + 3))), 0, NORM);
r3 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
r14 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
r25 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
r36 = plt_b32(mask_remaining_s0_0, POST_UPDATE);
vabs(r6, r5, r3, MODE_ZEROING);
vabs(r17, r16, r14, MODE_ZEROING);
vabs(r28, r27, r25, MODE_ZEROING);
vabs(r39, r38, r36, MODE_ZEROING);
vmuls(r7, r6, -0x1.0000000000000p+0f, r3, MODE_ZEROING);
vmuls(r18, r17, -0x1.0000000000000p+0f, r14, MODE_ZEROING);
vmuls(r29, r28, -0x1.0000000000000p+0f, r25, MODE_ZEROING);
vmuls(r40, r39, -0x1.0000000000000p+0f, r36, MODE_ZEROING);
vexp(r8, r7, r3, MODE_ZEROING);
vexp(r19, r18, r14, MODE_ZEROING);
vexp(r30, r29, r25, MODE_ZEROING);
vexp(r41, r40, r36, MODE_ZEROING);
vcmp_lt(r10, r5, r2, r3);
vcmp_lt(r21, r16, r2, r14);
vcmp_lt(r32, r27, r2, r25);
vcmp_lt(r43, r38, r2, r36);
vadds(r9, r8, 0x1.0000000000000p+0f, r3, MODE_ZEROING);
vadds(r20, r19, 0x1.0000000000000p+0f, r14, MODE_ZEROING);
vadds(r31, r30, 0x1.0000000000000p+0f, r25, MODE_ZEROING);
vadds(r42, r41, 0x1.0000000000000p+0f, r36, MODE_ZEROING);
vsel(r11, r1, r8, r10);
vsel(r22, r1, r19, r21);
vsel(r33, r1, r30, r32);
vsel(r44, r1, r41, r43);
vdiv(r12, r11, r9, r3, MODE_ZEROING);
vdiv(r23, r22, r20, r14, MODE_ZEROING);
vdiv(r34, r33, r31, r25, MODE_ZEROING);
vdiv(r45, r44, r42, r36, MODE_ZEROING);
vlds(r4, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 0))), 0, NORM);
vlds(r15, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 1))), 0, NORM);
vlds(r26, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 2))), 0, NORM);
vlds(r37, (__ubuf__ float*)(arena + (0 + 256 * (0 + 4 * iter_s0_0 + 3))), 0, NORM);
vmul(r13, r12, r4, r3, MODE_ZEROING);
vmul(r24, r23, r15, r14, MODE_ZEROING);
vmul(r35, r34, r26, r25, MODE_ZEROING);
vmul(r46, r45, r37, r36, MODE_ZEROING);
vsts(r13, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 0))), 0,
                 NORM_B32, r3);
vsts(r24, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 1))), 0,
                 NORM_B32, r14);
vsts(r35, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 2))), 0,
                 NORM_B32, r25);
vsts(r46, (__ubuf__ float*)(arena + (24576 + 256 * (0 + 4 * iter_s0_0 + 3))), 0,
                 NORM_B32, r36);
}
}
}

extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* src0Addr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* src1Addr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dstAddr = (__ubuf__ float*)get_imm(24576);
    nddma_desc a6_desc(nddma_desc::loop_desc(6144, 1, 1));
    nddma_out_to_ub((__ubuf__ uint32_t*)get_imm(0), (__gm__ uint32_t*)input, 0, a6_desc, 0, NEAREST_PADDING, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(src0Addr, src1Addr, dstAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    pipe_barrier(PIPE_ALL);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    __ubuf__ uint32_t* a6_offsets = (__ubuf__ uint32_t*)get_imm(0);
    a6_offsets[0] = 0;
    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    scatter_ubuf_to_gm((__gm__ uint32_t*)(output + 0), (__ubuf__ uint32_t*)dstAddr, 0, 0, a6_offsets, 0, 12288, 0, 1);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
