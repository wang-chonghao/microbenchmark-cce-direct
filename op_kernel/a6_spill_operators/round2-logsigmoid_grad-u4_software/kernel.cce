__aicore__ inline void candidate_vf(__ubuf__ float* src0Addr, __ubuf__ float* src1Addr,
                                    __ubuf__ float* dstAddr) {
    __ubuf__ uint8_t* arena = (__ubuf__ uint8_t*)get_imm(0);
    __VEC_SCOPE__ {
vector_bool r0;
vector_f32 r1;
