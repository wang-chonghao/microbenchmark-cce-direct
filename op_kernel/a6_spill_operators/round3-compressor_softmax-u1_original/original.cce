#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* outputAddr, __ubuf__ float* inputAddr) {
    constexpr uint32_t BASE_DEAL_SIZE = 4, BASE_REDUCE_SIZE = 2;
    uint32_t RowSize = 128, ReduceSize = 8, vScRealSize = 4;
    float minValue = -FLT_MAX;
    __VEC_SCOPE__ {

        vector_f32 vregSum00;
        vector_f32 vregSum10;
        vector_f32 vregSum20;
        vector_f32 vregSum30;
        vector_f32 vregSum01;
        vector_f32 vregSum11;
        vector_f32 vregSum21;
        vector_f32 vregSum31;
        vector_f32 vregSum02;
        vector_f32 vregSum12;
        vector_f32 vregSum22;
        vector_f32 vregSum32;
        vector_f32 vregSum03;
        vector_f32 vregSum13;
        vector_f32 vregSum23;
        vector_f32 vregSum33;

        vector_f32 vregExp00;
        vector_f32 vregExp10;
        vector_f32 vregExp20;
        vector_f32 vregExp30;
        vector_f32 vregExp01;
        vector_f32 vregExp11;
        vector_f32 vregExp21;
        vector_f32 vregExp31;
        vector_f32 vregExp02;
        vector_f32 vregExp12;
        vector_f32 vregExp22;
        vector_f32 vregExp32;
        vector_f32 vregExp03;
        vector_f32 vregExp13;
        vector_f32 vregExp23;
        vector_f32 vregExp33;

        vector_f32 vregF32_00;
        vector_f32 vregF32_10;
        vector_f32 vregF32_20;
        vector_f32 vregF32_30;
        vector_f32 vregF32_01;
        vector_f32 vregF32_11;
        vector_f32 vregF32_21;
        vector_f32 vregF32_31;
        vector_f32 vregF32_02;
        vector_f32 vregF32_12;
        vector_f32 vregF32_22;
        vector_f32 vregF32_32;
        vector_f32 vregF32_03;
        vector_f32 vregF32_13;
        vector_f32 vregF32_23;
        vector_f32 vregF32_33;

        vector_f32 vregStore00;
        vector_f32 vregStore10;
        vector_f32 vregStore20;
        vector_f32 vregStore30;
        vector_f32 vregStore01;
        vector_f32 vregStore11;
        vector_f32 vregStore21;
        vector_f32 vregStore31;
        vector_bool pregAll;
        pregAll = pset_b32(PAT_ALL);
        vector_f32 src00, src10, src20, src30, src01, src11, src21, src31, src02, src12, src22,
            src32, src03, src13, src23, src33;
        vector_f32 max00, max10, max20, max30, max01, max11, max21, max31, max02, max12, max22,
            max32, max03, max13, max23, max33;

        __ubuf__ float* srcUb00 = outputAddr;
        __ubuf__ float* srcUb01 = outputAddr + RowSize / 2;
        __ubuf__ float* srcUb02 = outputAddr + RowSize;
        __ubuf__ float* srcUb03 = outputAddr + RowSize + RowSize / 2;
        __ubuf__ float* srcUb10 = srcUb00 + ReduceSize * RowSize;
        __ubuf__ float* srcUb11 = srcUb00 + ReduceSize * RowSize + RowSize / 2;
        __ubuf__ float* srcUb12 = srcUb00 + ReduceSize * RowSize + RowSize;
        __ubuf__ float* srcUb13 = srcUb00 + ReduceSize * RowSize + RowSize + RowSize / 2;
        __ubuf__ float* srcUb20 = srcUb00 + ReduceSize * RowSize * 2;
        __ubuf__ float* srcUb21 = srcUb00 + ReduceSize * RowSize * 2 + RowSize / 2;
        __ubuf__ float* srcUb22 = srcUb00 + ReduceSize * RowSize * 2 + RowSize;
        __ubuf__ float* srcUb23 = srcUb00 + ReduceSize * RowSize * 2 + RowSize + RowSize / 2;
        __ubuf__ float* srcUb30 = srcUb00 + ReduceSize * RowSize * 3;
        __ubuf__ float* srcUb31 = srcUb00 + ReduceSize * RowSize * 3 + RowSize / 2;
        __ubuf__ float* srcUb32 = srcUb00 + ReduceSize * RowSize * 3 + RowSize;
        __ubuf__ float* srcUb33 = srcUb00 + ReduceSize * RowSize * 3 + RowSize + RowSize / 2;

        __ubuf__ float* inputAddr00 = inputAddr;
        __ubuf__ float* inputAddr01 = inputAddr + RowSize / 2;
        __ubuf__ float* inputAddr10 = inputAddr + (ReduceSize * RowSize);
        __ubuf__ float* inputAddr11 = inputAddr + (ReduceSize * RowSize) + RowSize / 2;
        __ubuf__ float* inputAddr20 = inputAddr + (ReduceSize * RowSize * 2);
        __ubuf__ float* inputAddr21 = inputAddr + (ReduceSize * RowSize * 2) + RowSize / 2;
        __ubuf__ float* inputAddr30 = inputAddr + (ReduceSize * RowSize * 3);
        __ubuf__ float* inputAddr31 = inputAddr + (ReduceSize * RowSize * 3) + RowSize / 2;

#pragma unroll 1

        for (uint16_t loopSc = 0; loopSc < uint16_t(vScRealSize / BASE_DEAL_SIZE); ++loopSc) {
            vdup(max00, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max10, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max20, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max30, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max01, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max11, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max21, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max31, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max02, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max12, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max22, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max32, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max03, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max13, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max23, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max33, minValue, pset_b32(PAT_ALL), MODE_ZEROING);

            vdup(vregSum00, 0, pregAll, MODE_ZEROING);
            vdup(vregSum10, 0, pregAll, MODE_ZEROING);
            vdup(vregSum20, 0, pregAll, MODE_ZEROING);
            vdup(vregSum30, 0, pregAll, MODE_ZEROING);
            vdup(vregSum01, 0, pregAll, MODE_ZEROING);
            vdup(vregSum11, 0, pregAll, MODE_ZEROING);
            vdup(vregSum21, 0, pregAll, MODE_ZEROING);
            vdup(vregSum31, 0, pregAll, MODE_ZEROING);
            vdup(vregSum02, 0, pregAll, MODE_ZEROING);
            vdup(vregSum12, 0, pregAll, MODE_ZEROING);
            vdup(vregSum22, 0, pregAll, MODE_ZEROING);
            vdup(vregSum32, 0, pregAll, MODE_ZEROING);
            vdup(vregSum03, 0, pregAll, MODE_ZEROING);
            vdup(vregSum13, 0, pregAll, MODE_ZEROING);
            vdup(vregSum23, 0, pregAll, MODE_ZEROING);
            vdup(vregSum33, 0, pregAll, MODE_ZEROING);
#pragma unroll 1
            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize / BASE_REDUCE_SIZE); ++loopM) {
                vlds(src00,
                     srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src01,
                     srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src02,
                     srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src03,
                     srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(src10,
                     srcUb10 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src11,
                     srcUb11 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src12,
                     srcUb12 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src13,
                     srcUb13 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(src20,
                     srcUb20 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src21,
                     srcUb21 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src22,
                     srcUb22 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src23,
                     srcUb23 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(src30,
                     srcUb30 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src31,
                     srcUb31 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src32,
                     srcUb32 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(src33,
                     srcUb33 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vmax(max00, max00, src00, pregAll, MODE_ZEROING);
                vmax(max01, max01, src01, pregAll, MODE_ZEROING);
                vmax(max02, max02, src02, pregAll, MODE_ZEROING);
                vmax(max03, max03, src03, pregAll, MODE_ZEROING);
                vmax(max10, max10, src10, pregAll, MODE_ZEROING);
                vmax(max11, max11, src11, pregAll, MODE_ZEROING);
                vmax(max12, max12, src12, pregAll, MODE_ZEROING);
                vmax(max13, max13, src13, pregAll, MODE_ZEROING);
                vmax(max20, max20, src20, pregAll, MODE_ZEROING);
                vmax(max21, max21, src21, pregAll, MODE_ZEROING);
                vmax(max22, max22, src22, pregAll, MODE_ZEROING);
                vmax(max23, max23, src23, pregAll, MODE_ZEROING);
                vmax(max30, max30, src30, pregAll, MODE_ZEROING);
                vmax(max31, max31, src31, pregAll, MODE_ZEROING);
                vmax(max32, max32, src32, pregAll, MODE_ZEROING);
                vmax(max33, max33, src33, pregAll, MODE_ZEROING);
            }

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize % BASE_REDUCE_SIZE); ++loopM) {
                uint16_t remOffset =
                    uint16_t(ReduceSize / BASE_REDUCE_SIZE) * RowSize * BASE_REDUCE_SIZE;
                vlds(src00, srcUb00 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src01, srcUb01 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src10, srcUb10 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src11, srcUb11 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src20, srcUb20 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src21, srcUb21 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src30, srcUb30 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(src31, srcUb31 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vmax(max00, max00, src00, pregAll, MODE_ZEROING);
                vmax(max01, max01, src01, pregAll, MODE_ZEROING);
                vmax(max10, max10, src10, pregAll, MODE_ZEROING);
                vmax(max11, max11, src11, pregAll, MODE_ZEROING);
                vmax(max20, max20, src20, pregAll, MODE_ZEROING);
                vmax(max21, max21, src21, pregAll, MODE_ZEROING);
                vmax(max30, max30, src30, pregAll, MODE_ZEROING);
                vmax(max31, max31, src31, pregAll, MODE_ZEROING);
            }

            vmax(max00, max00, max02, pregAll, MODE_ZEROING);
            vmax(max01, max01, max03, pregAll, MODE_ZEROING);
            vmax(max10, max10, max12, pregAll, MODE_ZEROING);
            vmax(max11, max11, max13, pregAll, MODE_ZEROING);
            vmax(max20, max20, max22, pregAll, MODE_ZEROING);
            vmax(max21, max21, max23, pregAll, MODE_ZEROING);
            vmax(max30, max30, max32, pregAll, MODE_ZEROING);
            vmax(max31, max31, max33, pregAll, MODE_ZEROING);

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize / BASE_REDUCE_SIZE); ++loopM) {
                vlds(vregF32_00,
                     srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_01,
                     srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_02,
                     srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_03,
                     srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(vregF32_10,
                     srcUb10 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_11,
                     srcUb11 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_12,
                     srcUb12 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_13,
                     srcUb13 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(vregF32_20,
                     srcUb20 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_21,
                     srcUb21 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_22,
                     srcUb22 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_23,
                     srcUb23 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vlds(vregF32_30,
                     srcUb30 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_31,
                     srcUb31 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_32,
                     srcUb32 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);
                vlds(vregF32_33,
                     srcUb33 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE,
                     0, NORM);

                vexpdif(vregExp00, vregF32_00, max00, pregAll, PART_EVEN);
                vexpdif(vregExp01, vregF32_01, max01, pregAll, PART_EVEN);
                vexpdif(vregExp02, vregF32_02, max00, pregAll, PART_EVEN);
                vexpdif(vregExp03, vregF32_03, max01, pregAll, PART_EVEN);
                vexpdif(vregExp10, vregF32_10, max10, pregAll, PART_EVEN);
                vexpdif(vregExp11, vregF32_11, max11, pregAll, PART_EVEN);
                vexpdif(vregExp12, vregF32_12, max10, pregAll, PART_EVEN);
                vexpdif(vregExp13, vregF32_13, max11, pregAll, PART_EVEN);
                vexpdif(vregExp20, vregF32_20, max20, pregAll, PART_EVEN);
                vexpdif(vregExp21, vregF32_21, max21, pregAll, PART_EVEN);
                vexpdif(vregExp22, vregF32_22, max20, pregAll, PART_EVEN);
                vexpdif(vregExp23, vregF32_23, max21, pregAll, PART_EVEN);
                vexpdif(vregExp30, vregF32_30, max30, pregAll, PART_EVEN);
                vexpdif(vregExp31, vregF32_31, max31, pregAll, PART_EVEN);
                vexpdif(vregExp32, vregF32_32, max30, pregAll, PART_EVEN);
                vexpdif(vregExp33, vregF32_33, max31, pregAll, PART_EVEN);

                vadd(vregSum00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vadd(vregSum01, vregExp01, vregSum01, pregAll, MODE_ZEROING);
                vadd(vregSum02, vregExp02, vregSum02, pregAll, MODE_ZEROING);
                vadd(vregSum03, vregExp03, vregSum03, pregAll, MODE_ZEROING);
                vadd(vregSum10, vregExp10, vregSum10, pregAll, MODE_ZEROING);
                vadd(vregSum11, vregExp11, vregSum11, pregAll, MODE_ZEROING);
                vadd(vregSum12, vregExp12, vregSum12, pregAll, MODE_ZEROING);
                vadd(vregSum13, vregExp13, vregSum13, pregAll, MODE_ZEROING);
                vadd(vregSum20, vregExp20, vregSum20, pregAll, MODE_ZEROING);
                vadd(vregSum21, vregExp21, vregSum21, pregAll, MODE_ZEROING);
                vadd(vregSum22, vregExp22, vregSum22, pregAll, MODE_ZEROING);
                vadd(vregSum23, vregExp23, vregSum23, pregAll, MODE_ZEROING);
                vadd(vregSum30, vregExp30, vregSum30, pregAll, MODE_ZEROING);
                vadd(vregSum31, vregExp31, vregSum31, pregAll, MODE_ZEROING);
                vadd(vregSum32, vregExp32, vregSum32, pregAll, MODE_ZEROING);
                vadd(vregSum33, vregExp33, vregSum33, pregAll, MODE_ZEROING);

                vsts(vregExp00,
                     (srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp01,
                     (srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp02,
                     (srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp03,
                     (srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp10,
                     (srcUb10 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp11,
                     (srcUb11 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp12,
                     (srcUb12 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp13,
                     (srcUb13 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp20,
                     (srcUb20 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp21,
                     (srcUb21 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp22,
                     (srcUb22 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp23,
                     (srcUb23 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp30,
                     (srcUb30 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp31,
                     (srcUb31 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp32,
                     (srcUb32 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregExp33,
                     (srcUb33 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
            }

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize % BASE_REDUCE_SIZE); ++loopM) {
                uint16_t remOffset =
                    uint16_t(ReduceSize / BASE_REDUCE_SIZE) * RowSize * BASE_REDUCE_SIZE;
                vlds(vregF32_00,
                     srcUb00 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_01,
                     srcUb01 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_10,
                     srcUb10 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_11,
                     srcUb11 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_20,
                     srcUb20 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_21,
                     srcUb21 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_30,
                     srcUb30 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);
                vlds(vregF32_31,
                     srcUb31 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0, NORM);

                vexpdif(vregExp00, vregF32_00, max00, pregAll, PART_EVEN);
                vexpdif(vregExp01, vregF32_01, max01, pregAll, PART_EVEN);
                vexpdif(vregExp10, vregF32_10, max10, pregAll, PART_EVEN);
                vexpdif(vregExp11, vregF32_11, max11, pregAll, PART_EVEN);
                vexpdif(vregExp20, vregF32_20, max20, pregAll, PART_EVEN);
                vexpdif(vregExp21, vregF32_21, max21, pregAll, PART_EVEN);
                vexpdif(vregExp30, vregF32_30, max30, pregAll, PART_EVEN);
                vexpdif(vregExp31, vregF32_31, max31, pregAll, PART_EVEN);

                vadd(vregSum00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vadd(vregSum01, vregExp01, vregSum01, pregAll, MODE_ZEROING);
                vadd(vregSum10, vregExp10, vregSum10, pregAll, MODE_ZEROING);
                vadd(vregSum11, vregExp11, vregSum11, pregAll, MODE_ZEROING);
                vadd(vregSum20, vregExp20, vregSum20, pregAll, MODE_ZEROING);
                vadd(vregSum21, vregExp21, vregSum21, pregAll, MODE_ZEROING);
                vadd(vregSum30, vregExp30, vregSum30, pregAll, MODE_ZEROING);
                vadd(vregSum31, vregExp31, vregSum31, pregAll, MODE_ZEROING);

                vsts(vregExp00,
                     (srcUb00 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp01,
                     (srcUb01 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp10,
                     (srcUb10 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp11,
                     (srcUb11 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp20,
                     (srcUb20 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp21,
                     (srcUb21 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp30,
                     (srcUb30 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
                vsts(vregExp31,
                     (srcUb31 + remOffset + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE), 0,
                     NORM_B32, pregAll);
            }

            vadd(vregSum00, vregSum00, vregSum02, pregAll, MODE_ZEROING);
            vadd(vregSum01, vregSum01, vregSum03, pregAll, MODE_ZEROING);
            vadd(vregSum10, vregSum10, vregSum12, pregAll, MODE_ZEROING);
            vadd(vregSum11, vregSum11, vregSum13, pregAll, MODE_ZEROING);
            vadd(vregSum20, vregSum20, vregSum22, pregAll, MODE_ZEROING);
            vadd(vregSum21, vregSum21, vregSum23, pregAll, MODE_ZEROING);
            vadd(vregSum30, vregSum30, vregSum32, pregAll, MODE_ZEROING);
            vadd(vregSum31, vregSum31, vregSum33, pregAll, MODE_ZEROING);

            mem_bar(VST_VLD);
#pragma unroll 1
            for (uint16_t loopM = 0; loopM < ReduceSize; ++loopM) {
                vlds(vregExp00,
                     srcUb00 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp01,
                     srcUb01 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp10,
                     srcUb10 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp11,
                     srcUb11 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp20,
                     srcUb20 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp21,
                     srcUb21 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp30,
                     srcUb30 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);
                vlds(vregExp31,
                     srcUb31 + loopM * RowSize + ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE, 0,
                     NORM);

                vdiv(vregStore00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vdiv(vregStore01, vregExp01, vregSum01, pregAll, MODE_ZEROING);
                vdiv(vregStore10, vregExp10, vregSum10, pregAll, MODE_ZEROING);
                vdiv(vregStore11, vregExp11, vregSum11, pregAll, MODE_ZEROING);
                vdiv(vregStore20, vregExp20, vregSum20, pregAll, MODE_ZEROING);
                vdiv(vregStore21, vregExp21, vregSum21, pregAll, MODE_ZEROING);
                vdiv(vregStore30, vregExp30, vregSum30, pregAll, MODE_ZEROING);
                vdiv(vregStore31, vregExp31, vregSum31, pregAll, MODE_ZEROING);

                vsts(vregStore00,
                     (inputAddr00 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore01,
                     (inputAddr01 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore10,
                     (inputAddr10 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore11,
                     (inputAddr11 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore20,
                     (inputAddr20 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore21,
                     (inputAddr21 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore30,
                     (inputAddr30 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
                vsts(vregStore31,
                     (inputAddr31 + loopM * RowSize +
                      ReduceSize * RowSize * loopSc * BASE_DEAL_SIZE),
                     0, NORM_B32, pregAll);
            }
        }

#pragma unroll 1
        for (uint16_t loopSc = 0; loopSc < uint16_t(vScRealSize % BASE_DEAL_SIZE); ++loopSc) {
            vdup(max00, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max01, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max02, minValue, pset_b32(PAT_ALL), MODE_ZEROING);
            vdup(max03, minValue, pset_b32(PAT_ALL), MODE_ZEROING);

            vdup(vregSum00, 0, pregAll, MODE_ZEROING);
            vdup(vregSum01, 0, pregAll, MODE_ZEROING);
            vdup(vregSum02, 0, pregAll, MODE_ZEROING);
            vdup(vregSum03, 0, pregAll, MODE_ZEROING);
#pragma unroll 1
            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize / BASE_REDUCE_SIZE); ++loopM) {
                vlds(src00,
                     srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(src01,
                     srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(src02,
                     srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(src03,
                     srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);

                vmax(max00, max00, src00, pregAll, MODE_ZEROING);
                vmax(max01, max01, src01, pregAll, MODE_ZEROING);
                vmax(max02, max02, src02, pregAll, MODE_ZEROING);
                vmax(max03, max03, src03, pregAll, MODE_ZEROING);
            }

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize % BASE_REDUCE_SIZE); ++loopM) {
                uint16_t remOffset =
                    uint16_t(ReduceSize / BASE_REDUCE_SIZE) * RowSize * BASE_REDUCE_SIZE;
                vlds(src00,
                     srcUb00 + remOffset +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(src01,
                     srcUb01 + remOffset +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vmax(max00, max00, src00, pregAll, MODE_ZEROING);
                vmax(max01, max01, src01, pregAll, MODE_ZEROING);
            }

            vmax(max00, max00, max02, pregAll, MODE_ZEROING);
            vmax(max01, max01, max03, pregAll, MODE_ZEROING);

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < ReduceSize / BASE_REDUCE_SIZE; ++loopM) {
                vlds(vregF32_00,
                     srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(vregF32_01,
                     srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(vregF32_02,
                     srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(vregF32_03,
                     srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);

                vexpdif(vregExp00, vregF32_00, max00, pregAll, PART_EVEN);
                vexpdif(vregExp01, vregF32_01, max01, pregAll, PART_EVEN);
                vexpdif(vregExp02, vregF32_02, max00, pregAll, PART_EVEN);
                vexpdif(vregExp03, vregF32_03, max01, pregAll, PART_EVEN);

                vadd(vregSum00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vadd(vregSum01, vregExp01, vregSum01, pregAll, MODE_ZEROING);
                vadd(vregSum02, vregExp02, vregSum02, pregAll, MODE_ZEROING);
                vadd(vregSum03, vregExp03, vregSum03, pregAll, MODE_ZEROING);

                vsts(vregExp00,
                     (srcUb00 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
                vsts(vregExp01,
                     (srcUb01 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
                vsts(vregExp02,
                     (srcUb02 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
                vsts(vregExp03,
                     (srcUb03 + loopM * RowSize * BASE_REDUCE_SIZE +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
            }

#pragma unroll 1

            for (uint16_t loopM = 0; loopM < uint16_t(ReduceSize % BASE_REDUCE_SIZE); ++loopM) {
                uint16_t remOffset =
                    uint16_t(ReduceSize / BASE_REDUCE_SIZE) * RowSize * BASE_REDUCE_SIZE;
                vlds(vregF32_00,
                     srcUb00 + remOffset +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(vregF32_01,
                     srcUb01 + remOffset +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);

                vexpdif(vregExp00, vregF32_00, max00, pregAll, PART_EVEN);
                vexpdif(vregExp01, vregF32_01, max01, pregAll, PART_EVEN);

                vadd(vregSum00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vadd(vregSum01, vregExp01, vregSum01, pregAll, MODE_ZEROING);

                vsts(vregExp00,
                     (srcUb00 + remOffset +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
                vsts(vregExp01,
                     (srcUb01 + remOffset +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
            }

            vadd(vregSum00, vregSum00, vregSum02, pregAll, MODE_ZEROING);
            vadd(vregSum01, vregSum01, vregSum03, pregAll, MODE_ZEROING);

            mem_bar(VST_VLD);
#pragma unroll 1
            for (uint16_t loopM = 0; loopM < ReduceSize; ++loopM) {
                vlds(vregExp00,
                     srcUb00 + loopM * RowSize +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);
                vlds(vregExp01,
                     srcUb01 + loopM * RowSize +
                         ReduceSize * RowSize *
                             (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE),
                     0, NORM);

                vdiv(vregStore00, vregExp00, vregSum00, pregAll, MODE_ZEROING);
                vdiv(vregStore01, vregExp01, vregSum01, pregAll, MODE_ZEROING);

                vsts(vregStore00,
                     (inputAddr00 + loopM * RowSize +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
                vsts(vregStore01,
                     (inputAddr01 + loopM * RowSize +
                      ReduceSize * RowSize *
                          (loopSc + vScRealSize / BASE_DEAL_SIZE * BASE_DEAL_SIZE)),
                     0, NORM_B32, pregAll);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* outputAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* inputAddr = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(outputAddr, inputAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)inputAddr, 0, 1, 16384, 0, 0, 0);
}
