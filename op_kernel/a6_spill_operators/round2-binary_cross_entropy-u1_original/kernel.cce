#include <stdint.h>
#ifndef __aicore__
#define __aicore__ [aicore]
#endif
#include <cfloat>
#include <type_traits>
__simd_callee__ inline void CalcYLogX(vector_f32& regYLogX, vector_f32& regX, vector_f32& regY,
                                      vector_bool& pregUp) {
    vector_f32 regLogX;
    vector_f32 regClipLogX;
    vln(regLogX, regX, pregUp, MODE_ZEROING);
    vmaxs(regClipLogX, regLogX, (float)-100.0, pregUp, MODE_ZEROING);
    vmul(regYLogX, regClipLogX, regY, pregUp, MODE_ZEROING);
}
__aicore__ inline void candidate_vf(__ubuf__ float* xAddr, __ubuf__ float* yAddr,
                                    __ubuf__ float* yLogXTAddr) {
    uint32_t totalLen = 3072, oneRepeat = 64, repeatTimes = 48;
    __VEC_SCOPE__ {
        vector_bool pregUp;
        vector_f32 regX;
        vector_f32 regY;
        vector_f32 regTensorOne;
        vector_f32 regOneSubX;
        vector_f32 regOneSubY;
        vector_f32 regOneSubYLogX;
        vector_f32 regYLogX;
        vector_f32 regDataSum;
        vector_f32 regBinaryYLogX;

#pragma unroll 1

        for (uint16_t i = 0; i < (uint16_t)repeatTimes; i++) {
            pregUp = plt_b32(totalLen, POST_UPDATE);
            vlds(regX, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
            vlds(regY, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);

            CalcYLogX(regYLogX, regX, regY, pregUp);
            vdup(regTensorOne, (float)1.0f, pregUp, MODE_ZEROING);
            vsub(regOneSubX, regTensorOne, regX, pregUp, MODE_ZEROING);
            vsub(regOneSubY, regTensorOne, regY, pregUp, MODE_ZEROING);
            CalcYLogX(regOneSubYLogX, regOneSubX, regOneSubY, pregUp);
            vadd(regDataSum, regYLogX, regOneSubYLogX, pregUp, MODE_ZEROING);
            vmuls(regBinaryYLogX, regDataSum, (float)-1.0f, pregUp, MODE_ZEROING);

            vsts(regBinaryYLogX, yLogXTAddr, (int32_t)oneRepeat, NORM_B32, pregUp, POST_UPDATE);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* yAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* yLogXTAddr = (__ubuf__ float*)get_imm(24576);
    nddma_desc a6_desc(nddma_desc::loop_desc(6144, 1, 1));
    nddma_out_to_ub((__ubuf__ uint32_t*)get_imm(0), (__gm__ uint32_t*)input, 0, a6_desc, 0, NEAREST_PADDING, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, yAddr, yLogXTAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    pipe_barrier(PIPE_ALL);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    __ubuf__ uint32_t* a6_offsets = (__ubuf__ uint32_t*)get_imm(0);
    a6_offsets[0] = 0;
    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    scatter_ubuf_to_gm((__gm__ uint32_t*)(output + 0), (__ubuf__ uint32_t*)yLogXTAddr, 0, 0, a6_offsets, 0, 12288, 0, 1);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
