#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__simd_callee__ inline void ClampMask(vector_bool& gateInRangeMask, vector_f32& gate,
                                      float clampLimit, vector_bool& activeMask) {
    vcmps_lt(gateInRangeMask, gate, clampLimit, activeMask);
}
__simd_callee__ inline void SelectMask(vector_f32& floatMask, vector_bool& conditionMask,
                                       vector_f32& ones, vector_f32& zeros) {
    vsel(floatMask, ones, zeros, conditionMask);
}
__simd_callee__ inline void ClipMask(vector_bool& upBelowUpperMask, vector_bool& upAboveLowerMask,
                                     vector_f32& negativeUp, vector_f32& up, float clampLimit,
                                     vector_bool& activeMask) {
    vcmps_lt(upBelowUpperMask, up, clampLimit, activeMask);
    vmuls(negativeUp, up, float(-1.0), activeMask, MODE_ZEROING);
    vcmps_lt(upAboveLowerMask, negativeUp, clampLimit, activeMask);
}
__simd_callee__ inline void ClampClip(vector_f32& gate, vector_f32& up, float clampLimit,
                                      vector_bool& activeMask) {
    vmins(gate, gate, clampLimit, activeMask, MODE_ZEROING);
    vmins(up, up, clampLimit, activeMask, MODE_ZEROING);
    vmaxs(up, up, float(-clampLimit), activeMask, MODE_ZEROING);
}
__simd_callee__ inline void Sigmoid(vector_f32& sigmoid, vector_f32& gate, vector_f32& ones,
                                    vector_bool& activeMask) {
    vector_f32 negativeGate;
    vector_f32 expNegativeGate;
    vector_f32 onePlusExp;
    vmuls(negativeGate, gate, float(-1.0), activeMask, MODE_ZEROING);
    vexp(expNegativeGate, negativeGate, activeMask, MODE_ZEROING);
    vadds(onePlusExp, expNegativeGate, float(1.0), activeMask, MODE_ZEROING);
    vdiv(sigmoid, ones, onePlusExp, activeMask, MODE_ZEROING);
}
__simd_callee__ inline void Silu(vector_f32& gate, vector_f32& sigmoid, vector_f32& zeros,
                                 vector_bool& activeMask) {
    vector_bool negInfMask;
    vector_bool belowPositiveMinMask;
    vector_bool negativeNormalMask;
    vector_f32 rawSilu;
    vector_f32 positiveSideFlushedSilu;
    vector_f32 flushedSilu;
    vcmps_eq(negInfMask, gate, -__builtin_inff(), activeMask);
    vmul(rawSilu, gate, sigmoid, activeMask, MODE_ZEROING);

    vcmps_lt(belowPositiveMinMask, rawSilu, FLT_MIN, activeMask);
    vsel(positiveSideFlushedSilu, zeros, rawSilu, belowPositiveMinMask);
    vcmps_le(negativeNormalMask, rawSilu, -FLT_MIN, activeMask);
    vsel(flushedSilu, rawSilu, positiveSideFlushedSilu, negativeNormalMask);
    vsel(gate, zeros, flushedSilu, negInfMask);
}
__simd_callee__ inline void SiluPrime(vector_f32& siluPrime, vector_f32& siluTimesSigmoid,
                                      vector_f32& sigmoid, vector_f32& silu, vector_f32& ones,
                                      vector_bool& activeMask) {
    vector_bool posInfMask;
    vector_f32 rawSiluPrime;
    vcmps_eq(posInfMask, silu, __builtin_inff(), activeMask);
    vmul(siluTimesSigmoid, silu, sigmoid, activeMask, MODE_ZEROING);
    vadd(rawSiluPrime, sigmoid, silu, activeMask, MODE_ZEROING);
    vsub(rawSiluPrime, rawSiluPrime, siluTimesSigmoid, activeMask, MODE_ZEROING);
    vsel(siluPrime, ones, rawSiluPrime, posInfMask);
}
__simd_callee__ inline void ComputeGradGate(vector_f32& gradGate, vector_f32& gradY,
                                            vector_f32& siluPrime, vector_f32& up,
                                            vector_f32& weight, vector_f32& gateClampMask,
                                            float rowMaskValue, vector_bool& activeMask) {
    vmul(gradGate, gradY, siluPrime, activeMask, MODE_ZEROING);
    vmul(gradGate, gradGate, up, activeMask, MODE_ZEROING);

    vmul(gradGate, gradGate, weight, activeMask, MODE_ZEROING);

    vmul(gradGate, gradGate, gateClampMask, activeMask, MODE_ZEROING);
}
__simd_callee__ inline void ComputeGradUp(vector_f32& gradUp, vector_f32& gradY, vector_f32& silu,
                                          vector_f32& weight, vector_f32& upClampMask,
                                          float rowMaskValue, vector_bool& activeMask) {
    vmul(gradUp, gradY, silu, activeMask, MODE_ZEROING);

    vmul(gradUp, gradUp, weight, activeMask, MODE_ZEROING);

    vmul(gradUp, gradUp, upClampMask, activeMask, MODE_ZEROING);
}
__aicore__ inline void candidate_vf(__ubuf__ float* gradYAddress, __ubuf__ float* gateAddress,
                                    __ubuf__ float* upAddress, __ubuf__ float* weightAddress,
                                    __ubuf__ float* yOriginAddress, __ubuf__ float* gradGateAddress,
                                    __ubuf__ float* gradUpAddress,
                                    __ubuf__ float* gradWeightProductAddress) {
    constexpr uint32_t FP32_VECTOR_LENGTH = 64;
    uint32_t elementCount = 1024;
    float clampLimit = 2.0f, rowMaskValue = 1.0f;
    __VEC_SCOPE__ {
        vector_bool activeMask;
        vector_bool fullMask = pset_b32(PAT_ALL);
        vector_f32 ones;
        vector_f32 zeros;
        vdup(ones, float(1.0), fullMask, MODE_ZEROING);
        vdup(zeros, float(0.0), fullMask, MODE_ZEROING);
        vector_f32 weight;

        vlds(weight, weightAddress, 0, BRC_B32);

        vector_f32 gradY;
        vector_f32 gate;
        vector_f32 up;
        vector_f32 sigmoid;
        vector_f32 siluPrime;
        vector_f32 siluTimesSigmoid;
        vector_f32 gradGate;
        vector_f32 gradUp;
        vector_f32 gateClampMask;
        vector_f32 upClampMask;
        vector_f32 gradWeightProduct;
        vector_f32 gradGateOutput;
        vector_f32 gradUpOutput;
        uint16_t repeatCount =
            static_cast<uint16_t>((elementCount + FP32_VECTOR_LENGTH - 1) / FP32_VECTOR_LENGTH);
        for (uint16_t repeatIndex = 0; repeatIndex < repeatCount; repeatIndex++) {
            uint32_t offset = repeatIndex * FP32_VECTOR_LENGTH;
            uint32_t currentElementCount = (elementCount - offset > FP32_VECTOR_LENGTH)
                                               ? FP32_VECTOR_LENGTH
                                               : (elementCount - offset);
            if (currentElementCount == FP32_VECTOR_LENGTH) {
                activeMask = fullMask;
            } else {
                activeMask = plt_b32(currentElementCount, POST_UPDATE);
            }
            vlds(gradY, gradYAddress + offset, 0, NORM);
            vlds(gate, gateAddress + offset, 0, NORM);
            vlds(up, upAddress + offset, 0, NORM);

            vector_bool gateInRangeMask;
            ClampMask(gateInRangeMask, gate, clampLimit, activeMask);
            SelectMask(gateClampMask, gateInRangeMask, ones, zeros);
            vector_bool upBelowUpperMask;
            vector_bool upAboveLowerMask;
            vector_f32 negativeUp;
            ClipMask(upBelowUpperMask, upAboveLowerMask, negativeUp, up, clampLimit, activeMask);
            vector_f32 upperBoundMask;
            vector_f32 lowerBoundMask;
            SelectMask(upperBoundMask, upBelowUpperMask, ones, zeros);
            SelectMask(lowerBoundMask, upAboveLowerMask, ones, zeros);
            vmul(upClampMask, upperBoundMask, lowerBoundMask, activeMask, MODE_ZEROING);
            ClampClip(gate, up, clampLimit, activeMask);

            Sigmoid(sigmoid, gate, ones, activeMask);
            Silu(gate, sigmoid, zeros, activeMask);

            vmul(gradWeightProduct, gradY, gate, activeMask, MODE_ZEROING);
            vmul(gradWeightProduct, gradWeightProduct, up, activeMask, MODE_ZEROING);
            vsts(gradWeightProduct, gradWeightProductAddress + offset, 0, NORM_B32, activeMask);

            SiluPrime(siluPrime, siluTimesSigmoid, sigmoid, gate, ones, activeMask);

            ComputeGradGate(gradGate, gradY, siluPrime, up, weight, gateClampMask, rowMaskValue,
                            activeMask);

            vsts(gradGate, (__ubuf__ float*)gradGateAddress + offset, 0, NORM_B32, activeMask);

            ComputeGradUp(gradUp, gradY, gate, weight, upClampMask, rowMaskValue, activeMask);

            vsts(gradUp, (__ubuf__ float*)gradUpAddress + offset, 0, NORM_B32, activeMask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* gradYAddress = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* gateAddress = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* upAddress = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* weightAddress = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* yOriginAddress = (__ubuf__ float*)get_imm(12544);
    __ubuf__ float* gradGateAddress = (__ubuf__ float*)get_imm(12800);
    __ubuf__ float* gradUpAddress = (__ubuf__ float*)get_imm(16896);
    __ubuf__ float* gradWeightProductAddress = (__ubuf__ float*)get_imm(20992);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12800, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(gradYAddress, gateAddress, upAddress, weightAddress, yOriginAddress,
                 gradGateAddress, gradUpAddress, gradWeightProductAddress);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)gradGateAddress, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 4096, (__ubuf__ uint8_t*)gradUpAddress, 0, 1, 4096, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 8192, (__ubuf__ uint8_t*)gradWeightProductAddress, 0, 1, 4096,
                             0, 0, 0);
}
