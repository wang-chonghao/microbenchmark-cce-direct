#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* xPtr, __ubuf__ float* dyPtr,
                                    __ubuf__ float* gammaPtr, __ubuf__ float* betaPtr,
                                    __ubuf__ float* c1Ptr, __ubuf__ float* c2Ptr,
                                    __ubuf__ float* meanRstdPtr, __ubuf__ float* dxPtr) {
    uint32_t calCount = 6144, cGIdx = 0;
    constexpr uint32_t oneRepeatSizeB32 = 64, rstdValueOffset = 8;
    float swishScaleValue = 0.800000011920929f;
    __VEC_SCOPE__ {

        vector_bool maskFull0;
        vector_bool maskFull1;
        vector_f32 vGamma, vBeta, vC1, vC2, vRstd;
        vector_f32 vX0, vDy0, vYMul0, vY0, vDenScaled0, vDenExp0, vDen0;
        vector_f32 vDswish0, vDyNew0, vCorrectionMul0, vCorrection0, vDx0;
        vector_f32 vX1, vDy1, vYMul1, vY1, vDenScaled1, vDenExp1, vDen1;
        vector_f32 vDswish1, vDyNew1, vCorrectionMul1, vCorrection1, vDx1;
        uint32_t fullRepeatTimes = (calCount + oneRepeatSizeB32 - 1) / oneRepeatSizeB32;
        uint16_t pairRepeatTimes = static_cast<uint16_t>((fullRepeatTimes + 1) / 2);
        vlds(vGamma, gammaPtr + cGIdx, 0, BRC_B32);
        vlds(vBeta, betaPtr + cGIdx, 0, BRC_B32);
        vlds(vC1, c1Ptr, 0, BRC_B32);
        vlds(vC2, c2Ptr, 0, BRC_B32);
        vlds(vRstd, meanRstdPtr + rstdValueOffset, 0, BRC_B32);
        {
            vector_bool maskFull0_u0;
            vector_bool maskFull0_u1;
            vector_bool maskFull0_u2;
            vector_bool maskFull0_u3;
            vector_bool maskFull1_u0;
            vector_bool maskFull1_u1;
            vector_bool maskFull1_u2;
            vector_bool maskFull1_u3;
            vector_f32 vCorrection0_u0;
            vector_f32 vCorrection0_u1;
            vector_f32 vCorrection0_u2;
            vector_f32 vCorrection0_u3;
            vector_f32 vCorrection1_u0;
            vector_f32 vCorrection1_u1;
            vector_f32 vCorrection1_u2;
            vector_f32 vCorrection1_u3;
            vector_f32 vCorrectionMul0_u0;
            vector_f32 vCorrectionMul0_u1;
            vector_f32 vCorrectionMul0_u2;
            vector_f32 vCorrectionMul0_u3;
            vector_f32 vCorrectionMul1_u0;
            vector_f32 vCorrectionMul1_u1;
            vector_f32 vCorrectionMul1_u2;
            vector_f32 vCorrectionMul1_u3;
            vector_f32 vDen0_u0;
            vector_f32 vDen0_u1;
            vector_f32 vDen0_u2;
            vector_f32 vDen0_u3;
            vector_f32 vDen1_u0;
            vector_f32 vDen1_u1;
            vector_f32 vDen1_u2;
            vector_f32 vDen1_u3;
            vector_f32 vDenExp0_u0;
            vector_f32 vDenExp0_u1;
            vector_f32 vDenExp0_u2;
            vector_f32 vDenExp0_u3;
            vector_f32 vDenExp1_u0;
            vector_f32 vDenExp1_u1;
            vector_f32 vDenExp1_u2;
            vector_f32 vDenExp1_u3;
            vector_f32 vDenScaled0_u0;
            vector_f32 vDenScaled0_u1;
            vector_f32 vDenScaled0_u2;
            vector_f32 vDenScaled0_u3;
            vector_f32 vDenScaled1_u0;
            vector_f32 vDenScaled1_u1;
            vector_f32 vDenScaled1_u2;
            vector_f32 vDenScaled1_u3;
            vector_f32 vDswish0_u0;
            vector_f32 vDswish0_u1;
            vector_f32 vDswish0_u2;
            vector_f32 vDswish0_u3;
            vector_f32 vDswish1_u0;
            vector_f32 vDswish1_u1;
            vector_f32 vDswish1_u2;
            vector_f32 vDswish1_u3;
            vector_f32 vDx0_u0;
            vector_f32 vDx0_u1;
            vector_f32 vDx0_u2;
            vector_f32 vDx0_u3;
            vector_f32 vDx1_u0;
            vector_f32 vDx1_u1;
            vector_f32 vDx1_u2;
            vector_f32 vDx1_u3;
            vector_f32 vDy0_u0;
            vector_f32 vDy0_u1;
            vector_f32 vDy0_u2;
            vector_f32 vDy0_u3;
            vector_f32 vDy1_u0;
            vector_f32 vDy1_u1;
            vector_f32 vDy1_u2;
            vector_f32 vDy1_u3;
            vector_f32 vDyNew0_u0;
            vector_f32 vDyNew0_u1;
            vector_f32 vDyNew0_u2;
            vector_f32 vDyNew0_u3;
            vector_f32 vDyNew1_u0;
            vector_f32 vDyNew1_u1;
            vector_f32 vDyNew1_u2;
            vector_f32 vDyNew1_u3;
            vector_f32 vX0_u0;
            vector_f32 vX0_u1;
            vector_f32 vX0_u2;
            vector_f32 vX0_u3;
            vector_f32 vX1_u0;
            vector_f32 vX1_u1;
            vector_f32 vX1_u2;
            vector_f32 vX1_u3;
            vector_f32 vY0_u0;
            vector_f32 vY0_u1;
            vector_f32 vY0_u2;
            vector_f32 vY0_u3;
            vector_f32 vY1_u0;
            vector_f32 vY1_u1;
            vector_f32 vY1_u2;
            vector_f32 vY1_u3;
            vector_f32 vYMul0_u0;
            vector_f32 vYMul0_u1;
            vector_f32 vYMul0_u2;
            vector_f32 vYMul0_u3;
            vector_f32 vYMul1_u0;
            vector_f32 vYMul1_u1;
            vector_f32 vYMul1_u2;
            vector_f32 vYMul1_u3;
#pragma unroll 1
            for (uint32_t i = 0; i < 48; i += 4) {
                uint32_t offset0_u0 = (i + 0) * 2 * oneRepeatSizeB32;
                uint32_t offset0_u1 = (i + 1) * 2 * oneRepeatSizeB32;
                uint32_t offset0_u2 = (i + 2) * 2 * oneRepeatSizeB32;
                uint32_t offset0_u3 = (i + 3) * 2 * oneRepeatSizeB32;
                uint32_t offset1_u0 = offset0_u0 + oneRepeatSizeB32;
                uint32_t offset1_u1 = offset0_u1 + oneRepeatSizeB32;
                uint32_t offset1_u2 = offset0_u2 + oneRepeatSizeB32;
                uint32_t offset1_u3 = offset0_u3 + oneRepeatSizeB32;
                maskFull0_u0 = plt_b32(calCount, POST_UPDATE);
                maskFull0_u1 = plt_b32(calCount, POST_UPDATE);
                maskFull0_u2 = plt_b32(calCount, POST_UPDATE);
                maskFull0_u3 = plt_b32(calCount, POST_UPDATE);
                maskFull1_u0 = plt_b32(calCount, POST_UPDATE);
                maskFull1_u1 = plt_b32(calCount, POST_UPDATE);
                maskFull1_u2 = plt_b32(calCount, POST_UPDATE);
                maskFull1_u3 = plt_b32(calCount, POST_UPDATE);
                vlds(vX0_u0, xPtr + offset0_u0, 0, NORM);
                vlds(vX0_u1, xPtr + offset0_u1, 0, NORM);
                vlds(vX0_u2, xPtr + offset0_u2, 0, NORM);
                vlds(vX0_u3, xPtr + offset0_u3, 0, NORM);
                vlds(vDy0_u0, dyPtr + offset0_u0, 0, NORM);
                vlds(vDy0_u1, dyPtr + offset0_u1, 0, NORM);
                vlds(vDy0_u2, dyPtr + offset0_u2, 0, NORM);
                vlds(vDy0_u3, dyPtr + offset0_u3, 0, NORM);
                vlds(vX1_u0, xPtr + offset1_u0, 0, NORM);
                vlds(vX1_u1, xPtr + offset1_u1, 0, NORM);
                vlds(vX1_u2, xPtr + offset1_u2, 0, NORM);
                vlds(vX1_u3, xPtr + offset1_u3, 0, NORM);
                vlds(vDy1_u0, dyPtr + offset1_u0, 0, NORM);
                vlds(vDy1_u1, dyPtr + offset1_u1, 0, NORM);
                vlds(vDy1_u2, dyPtr + offset1_u2, 0, NORM);
                vlds(vDy1_u3, dyPtr + offset1_u3, 0, NORM);
                vmul(vYMul0_u0, vX0_u0, vGamma, maskFull0_u0, MODE_ZEROING);
                vmul(vYMul0_u1, vX0_u1, vGamma, maskFull0_u1, MODE_ZEROING);
                vmul(vYMul0_u2, vX0_u2, vGamma, maskFull0_u2, MODE_ZEROING);
                vmul(vYMul0_u3, vX0_u3, vGamma, maskFull0_u3, MODE_ZEROING);
                vmul(vYMul1_u0, vX1_u0, vGamma, maskFull1_u0, MODE_ZEROING);
                vmul(vYMul1_u1, vX1_u1, vGamma, maskFull1_u1, MODE_ZEROING);
                vmul(vYMul1_u2, vX1_u2, vGamma, maskFull1_u2, MODE_ZEROING);
                vmul(vYMul1_u3, vX1_u3, vGamma, maskFull1_u3, MODE_ZEROING);
                vadd(vY0_u0, vYMul0_u0, vBeta, maskFull0_u0, MODE_ZEROING);
                vadd(vY0_u1, vYMul0_u1, vBeta, maskFull0_u1, MODE_ZEROING);
                vadd(vY0_u2, vYMul0_u2, vBeta, maskFull0_u2, MODE_ZEROING);
                vadd(vY0_u3, vYMul0_u3, vBeta, maskFull0_u3, MODE_ZEROING);
                vadd(vY1_u0, vYMul1_u0, vBeta, maskFull1_u0, MODE_ZEROING);
                vadd(vY1_u1, vYMul1_u1, vBeta, maskFull1_u1, MODE_ZEROING);
                vadd(vY1_u2, vYMul1_u2, vBeta, maskFull1_u2, MODE_ZEROING);
                vadd(vY1_u3, vYMul1_u3, vBeta, maskFull1_u3, MODE_ZEROING);
                vmuls(vYMul0_u0, vY0_u0, swishScaleValue, maskFull0_u0, MODE_ZEROING);
                vmuls(vYMul0_u1, vY0_u1, swishScaleValue, maskFull0_u1, MODE_ZEROING);
                vmuls(vYMul0_u2, vY0_u2, swishScaleValue, maskFull0_u2, MODE_ZEROING);
                vmuls(vYMul0_u3, vY0_u3, swishScaleValue, maskFull0_u3, MODE_ZEROING);
                vmuls(vYMul1_u0, vY1_u0, swishScaleValue, maskFull1_u0, MODE_ZEROING);
                vmuls(vYMul1_u1, vY1_u1, swishScaleValue, maskFull1_u1, MODE_ZEROING);
                vmuls(vYMul1_u2, vY1_u2, swishScaleValue, maskFull1_u2, MODE_ZEROING);
                vmuls(vYMul1_u3, vY1_u3, swishScaleValue, maskFull1_u3, MODE_ZEROING);
                vmuls(vDenScaled0_u0, vYMul0_u0, float(-1.0), maskFull0_u0, MODE_ZEROING);
                vmuls(vDenScaled0_u1, vYMul0_u1, float(-1.0), maskFull0_u1, MODE_ZEROING);
                vmuls(vDenScaled0_u2, vYMul0_u2, float(-1.0), maskFull0_u2, MODE_ZEROING);
                vmuls(vDenScaled0_u3, vYMul0_u3, float(-1.0), maskFull0_u3, MODE_ZEROING);
                vmuls(vDenScaled1_u0, vYMul1_u0, float(-1.0), maskFull1_u0, MODE_ZEROING);
                vmuls(vDenScaled1_u1, vYMul1_u1, float(-1.0), maskFull1_u1, MODE_ZEROING);
                vmuls(vDenScaled1_u2, vYMul1_u2, float(-1.0), maskFull1_u2, MODE_ZEROING);
                vmuls(vDenScaled1_u3, vYMul1_u3, float(-1.0), maskFull1_u3, MODE_ZEROING);
                vexp(vDenExp0_u0, vDenScaled0_u0, maskFull0_u0, MODE_ZEROING);
                vexp(vDenExp0_u1, vDenScaled0_u1, maskFull0_u1, MODE_ZEROING);
                vexp(vDenExp0_u2, vDenScaled0_u2, maskFull0_u2, MODE_ZEROING);
                vexp(vDenExp0_u3, vDenScaled0_u3, maskFull0_u3, MODE_ZEROING);
                vexp(vDenExp1_u0, vDenScaled1_u0, maskFull1_u0, MODE_ZEROING);
                vexp(vDenExp1_u1, vDenScaled1_u1, maskFull1_u1, MODE_ZEROING);
                vexp(vDenExp1_u2, vDenScaled1_u2, maskFull1_u2, MODE_ZEROING);
                vexp(vDenExp1_u3, vDenScaled1_u3, maskFull1_u3, MODE_ZEROING);
                vadds(vDen0_u0, vDenExp0_u0, float(1.0), maskFull0_u0, MODE_ZEROING);
                vadds(vDen0_u1, vDenExp0_u1, float(1.0), maskFull0_u1, MODE_ZEROING);
                vadds(vDen0_u2, vDenExp0_u2, float(1.0), maskFull0_u2, MODE_ZEROING);
                vadds(vDen0_u3, vDenExp0_u3, float(1.0), maskFull0_u3, MODE_ZEROING);
                vadds(vDen1_u0, vDenExp1_u0, float(1.0), maskFull1_u0, MODE_ZEROING);
                vadds(vDen1_u1, vDenExp1_u1, float(1.0), maskFull1_u1, MODE_ZEROING);
                vadds(vDen1_u2, vDenExp1_u2, float(1.0), maskFull1_u2, MODE_ZEROING);
                vadds(vDen1_u3, vDenExp1_u3, float(1.0), maskFull1_u3, MODE_ZEROING);
                vdiv(vDenScaled0_u0, vYMul0_u0, vDen0_u0, maskFull0_u0, MODE_ZEROING);
                vdiv(vDenScaled0_u1, vYMul0_u1, vDen0_u1, maskFull0_u1, MODE_ZEROING);
                vdiv(vDenScaled0_u2, vYMul0_u2, vDen0_u2, maskFull0_u2, MODE_ZEROING);
                vdiv(vDenScaled0_u3, vYMul0_u3, vDen0_u3, maskFull0_u3, MODE_ZEROING);
                vdiv(vDenScaled1_u0, vYMul1_u0, vDen1_u0, maskFull1_u0, MODE_ZEROING);
                vdiv(vDenScaled1_u1, vYMul1_u1, vDen1_u1, maskFull1_u1, MODE_ZEROING);
                vdiv(vDenScaled1_u2, vYMul1_u2, vDen1_u2, maskFull1_u2, MODE_ZEROING);
                vdiv(vDenScaled1_u3, vYMul1_u3, vDen1_u3, maskFull1_u3, MODE_ZEROING);
                vsub(vDenExp0_u0, vYMul0_u0, vDenScaled0_u0, maskFull0_u0, MODE_ZEROING);
                vsub(vDenExp0_u1, vYMul0_u1, vDenScaled0_u1, maskFull0_u1, MODE_ZEROING);
                vsub(vDenExp0_u2, vYMul0_u2, vDenScaled0_u2, maskFull0_u2, MODE_ZEROING);
                vsub(vDenExp0_u3, vYMul0_u3, vDenScaled0_u3, maskFull0_u3, MODE_ZEROING);
                vsub(vDenExp1_u0, vYMul1_u0, vDenScaled1_u0, maskFull1_u0, MODE_ZEROING);
                vsub(vDenExp1_u1, vYMul1_u1, vDenScaled1_u1, maskFull1_u1, MODE_ZEROING);
                vsub(vDenExp1_u2, vYMul1_u2, vDenScaled1_u2, maskFull1_u2, MODE_ZEROING);
                vsub(vDenExp1_u3, vYMul1_u3, vDenScaled1_u3, maskFull1_u3, MODE_ZEROING);
                vadds(vYMul0_u0, vDenExp0_u0, float(1.0), maskFull0_u0, MODE_ZEROING);
                vadds(vYMul0_u1, vDenExp0_u1, float(1.0), maskFull0_u1, MODE_ZEROING);
                vadds(vYMul0_u2, vDenExp0_u2, float(1.0), maskFull0_u2, MODE_ZEROING);
                vadds(vYMul0_u3, vDenExp0_u3, float(1.0), maskFull0_u3, MODE_ZEROING);
                vadds(vYMul1_u0, vDenExp1_u0, float(1.0), maskFull1_u0, MODE_ZEROING);
                vadds(vYMul1_u1, vDenExp1_u1, float(1.0), maskFull1_u1, MODE_ZEROING);
                vadds(vYMul1_u2, vDenExp1_u2, float(1.0), maskFull1_u2, MODE_ZEROING);
                vadds(vYMul1_u3, vDenExp1_u3, float(1.0), maskFull1_u3, MODE_ZEROING);
                vdiv(vDswish0_u0, vYMul0_u0, vDen0_u0, maskFull0_u0, MODE_ZEROING);
                vdiv(vDswish0_u1, vYMul0_u1, vDen0_u1, maskFull0_u1, MODE_ZEROING);
                vdiv(vDswish0_u2, vYMul0_u2, vDen0_u2, maskFull0_u2, MODE_ZEROING);
                vdiv(vDswish0_u3, vYMul0_u3, vDen0_u3, maskFull0_u3, MODE_ZEROING);
                vdiv(vDswish1_u0, vYMul1_u0, vDen1_u0, maskFull1_u0, MODE_ZEROING);
                vdiv(vDswish1_u1, vYMul1_u1, vDen1_u1, maskFull1_u1, MODE_ZEROING);
                vdiv(vDswish1_u2, vYMul1_u2, vDen1_u2, maskFull1_u2, MODE_ZEROING);
                vdiv(vDswish1_u3, vYMul1_u3, vDen1_u3, maskFull1_u3, MODE_ZEROING);
                vmul(vDyNew0_u0, vDswish0_u0, vDy0_u0, maskFull0_u0, MODE_ZEROING);
                vmul(vDyNew0_u1, vDswish0_u1, vDy0_u1, maskFull0_u1, MODE_ZEROING);
                vmul(vDyNew0_u2, vDswish0_u2, vDy0_u2, maskFull0_u2, MODE_ZEROING);
                vmul(vDyNew0_u3, vDswish0_u3, vDy0_u3, maskFull0_u3, MODE_ZEROING);
                vmul(vDyNew1_u0, vDswish1_u0, vDy1_u0, maskFull1_u0, MODE_ZEROING);
                vmul(vDyNew1_u1, vDswish1_u1, vDy1_u1, maskFull1_u1, MODE_ZEROING);
                vmul(vDyNew1_u2, vDswish1_u2, vDy1_u2, maskFull1_u2, MODE_ZEROING);
                vmul(vDyNew1_u3, vDswish1_u3, vDy1_u3, maskFull1_u3, MODE_ZEROING);
                vmul(vDswish0_u0, vDyNew0_u0, vGamma, maskFull0_u0, MODE_ZEROING);
                vmul(vDswish0_u1, vDyNew0_u1, vGamma, maskFull0_u1, MODE_ZEROING);
                vmul(vDswish0_u2, vDyNew0_u2, vGamma, maskFull0_u2, MODE_ZEROING);
                vmul(vDswish0_u3, vDyNew0_u3, vGamma, maskFull0_u3, MODE_ZEROING);
                vmul(vDswish1_u0, vDyNew1_u0, vGamma, maskFull1_u0, MODE_ZEROING);
                vmul(vDswish1_u1, vDyNew1_u1, vGamma, maskFull1_u1, MODE_ZEROING);
                vmul(vDswish1_u2, vDyNew1_u2, vGamma, maskFull1_u2, MODE_ZEROING);
                vmul(vDswish1_u3, vDyNew1_u3, vGamma, maskFull1_u3, MODE_ZEROING);
                vmul(vDyNew0_u0, vDswish0_u0, vRstd, maskFull0_u0, MODE_ZEROING);
                vmul(vDyNew0_u1, vDswish0_u1, vRstd, maskFull0_u1, MODE_ZEROING);
                vmul(vDyNew0_u2, vDswish0_u2, vRstd, maskFull0_u2, MODE_ZEROING);
                vmul(vDyNew0_u3, vDswish0_u3, vRstd, maskFull0_u3, MODE_ZEROING);
                vmul(vDyNew1_u0, vDswish1_u0, vRstd, maskFull1_u0, MODE_ZEROING);
                vmul(vDyNew1_u1, vDswish1_u1, vRstd, maskFull1_u1, MODE_ZEROING);
                vmul(vDyNew1_u2, vDswish1_u2, vRstd, maskFull1_u2, MODE_ZEROING);
                vmul(vDyNew1_u3, vDswish1_u3, vRstd, maskFull1_u3, MODE_ZEROING);
                vmul(vCorrectionMul0_u0, vX0_u0, vC2, maskFull0_u0, MODE_ZEROING);
                vmul(vCorrectionMul0_u1, vX0_u1, vC2, maskFull0_u1, MODE_ZEROING);
                vmul(vCorrectionMul0_u2, vX0_u2, vC2, maskFull0_u2, MODE_ZEROING);
                vmul(vCorrectionMul0_u3, vX0_u3, vC2, maskFull0_u3, MODE_ZEROING);
                vmul(vCorrectionMul1_u0, vX1_u0, vC2, maskFull1_u0, MODE_ZEROING);
                vmul(vCorrectionMul1_u1, vX1_u1, vC2, maskFull1_u1, MODE_ZEROING);
                vmul(vCorrectionMul1_u2, vX1_u2, vC2, maskFull1_u2, MODE_ZEROING);
                vmul(vCorrectionMul1_u3, vX1_u3, vC2, maskFull1_u3, MODE_ZEROING);
                vadd(vCorrection0_u0, vCorrectionMul0_u0, vC1, maskFull0_u0, MODE_ZEROING);
                vadd(vCorrection0_u1, vCorrectionMul0_u1, vC1, maskFull0_u1, MODE_ZEROING);
                vadd(vCorrection0_u2, vCorrectionMul0_u2, vC1, maskFull0_u2, MODE_ZEROING);
                vadd(vCorrection0_u3, vCorrectionMul0_u3, vC1, maskFull0_u3, MODE_ZEROING);
                vadd(vCorrection1_u0, vCorrectionMul1_u0, vC1, maskFull1_u0, MODE_ZEROING);
                vadd(vCorrection1_u1, vCorrectionMul1_u1, vC1, maskFull1_u1, MODE_ZEROING);
                vadd(vCorrection1_u2, vCorrectionMul1_u2, vC1, maskFull1_u2, MODE_ZEROING);
                vadd(vCorrection1_u3, vCorrectionMul1_u3, vC1, maskFull1_u3, MODE_ZEROING);
                vmul(vCorrectionMul0_u0, vCorrection0_u0, vRstd, maskFull0_u0, MODE_ZEROING);
                vmul(vCorrectionMul0_u1, vCorrection0_u1, vRstd, maskFull0_u1, MODE_ZEROING);
                vmul(vCorrectionMul0_u2, vCorrection0_u2, vRstd, maskFull0_u2, MODE_ZEROING);
                vmul(vCorrectionMul0_u3, vCorrection0_u3, vRstd, maskFull0_u3, MODE_ZEROING);
                vmul(vCorrectionMul1_u0, vCorrection1_u0, vRstd, maskFull1_u0, MODE_ZEROING);
                vmul(vCorrectionMul1_u1, vCorrection1_u1, vRstd, maskFull1_u1, MODE_ZEROING);
                vmul(vCorrectionMul1_u2, vCorrection1_u2, vRstd, maskFull1_u2, MODE_ZEROING);
                vmul(vCorrectionMul1_u3, vCorrection1_u3, vRstd, maskFull1_u3, MODE_ZEROING);
                vsub(vDx0_u0, vDyNew0_u0, vCorrectionMul0_u0, maskFull0_u0, MODE_ZEROING);
                vsub(vDx0_u1, vDyNew0_u1, vCorrectionMul0_u1, maskFull0_u1, MODE_ZEROING);
                vsub(vDx0_u2, vDyNew0_u2, vCorrectionMul0_u2, maskFull0_u2, MODE_ZEROING);
                vsub(vDx0_u3, vDyNew0_u3, vCorrectionMul0_u3, maskFull0_u3, MODE_ZEROING);
                vsub(vDx1_u0, vDyNew1_u0, vCorrectionMul1_u0, maskFull1_u0, MODE_ZEROING);
                vsub(vDx1_u1, vDyNew1_u1, vCorrectionMul1_u1, maskFull1_u1, MODE_ZEROING);
                vsub(vDx1_u2, vDyNew1_u2, vCorrectionMul1_u2, maskFull1_u2, MODE_ZEROING);
                vsub(vDx1_u3, vDyNew1_u3, vCorrectionMul1_u3, maskFull1_u3, MODE_ZEROING);
                vsts(vDx0_u0, dxPtr + offset0_u0, 0, NORM_B32, maskFull0_u0);
                vsts(vDx0_u1, dxPtr + offset0_u1, 0, NORM_B32, maskFull0_u1);
                vsts(vDx0_u2, dxPtr + offset0_u2, 0, NORM_B32, maskFull0_u2);
                vsts(vDx0_u3, dxPtr + offset0_u3, 0, NORM_B32, maskFull0_u3);
                vsts(vDx1_u0, dxPtr + offset1_u0, 0, NORM_B32, maskFull1_u0);
                vsts(vDx1_u1, dxPtr + offset1_u1, 0, NORM_B32, maskFull1_u1);
                vsts(vDx1_u2, dxPtr + offset1_u2, 0, NORM_B32, maskFull1_u2);
                vsts(vDx1_u3, dxPtr + offset1_u3, 0, NORM_B32, maskFull1_u3);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xPtr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dyPtr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* gammaPtr = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* betaPtr = (__ubuf__ float*)get_imm(49408);
    __ubuf__ float* c1Ptr = (__ubuf__ float*)get_imm(49664);
    __ubuf__ float* c2Ptr = (__ubuf__ float*)get_imm(49920);
    __ubuf__ float* meanRstdPtr = (__ubuf__ float*)get_imm(50176);
    __ubuf__ float* dxPtr = (__ubuf__ float*)get_imm(50432);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 50432, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xPtr, dyPtr, gammaPtr, betaPtr, c1Ptr, c2Ptr, meanRstdPtr, dxPtr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dxPtr, 0, 1, 24576, 0, 0, 0);
}
