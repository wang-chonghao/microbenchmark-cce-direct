#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* src, __ubuf__ float* dst) {
    uint32_t count = 3072;
    __VEC_SCOPE__ {
        vector_f32 x, pos, neg, t, pres, nres, y;
        vector_bool mask;
#pragma unroll 1
        for (uint16_t i = 0; i < 48; ++i) {
            mask = plt_b32(count, POST_UPDATE);
            vlds(x, src + i * 64, 0, NORM);
            vmaxs(pos, x, 0.0f, mask, MODE_ZEROING);
            vmuls(t, pos, -1.0f, mask, MODE_ZEROING);
            vexp(t, t, mask, MODE_ZEROING);
            vadds(t, t, 1.0f, mask, MODE_ZEROING);
            vln(pres, t, mask, MODE_ZEROING);
            vadd(pres, pres, pos, mask, MODE_ZEROING);
            vmins(neg, x, 0.0f, mask, MODE_ZEROING);
            vexp(t, neg, mask, MODE_ZEROING);
            vadds(t, t, 1.0f, mask, MODE_ZEROING);
            vln(nres, t, mask, MODE_ZEROING);
            vadd(y, pres, nres, mask, MODE_ZEROING);
            vadds(y, y, -0.6931471805599453f, mask, MODE_ZEROING);
            vsts(y, dst + i * 64, 0, NORM_B32, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* src = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(12288);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12288, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(src, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dst, 0, 1, 12288, 0, 0, 0);
}
