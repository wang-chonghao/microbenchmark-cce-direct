extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xLocal = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* gammaLocal = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* betaLocal = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* meanLocal = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* rstdLocal = (__ubuf__ float*)get_imm(12544);
    __ubuf__ float* yLocal = (__ubuf__ float*)get_imm(12800);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 12800, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xLocal, gammaLocal, betaLocal, meanLocal, rstdLocal, yLocal);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)yLocal, 0, 1, 4096, 0, 0, 0);
}
