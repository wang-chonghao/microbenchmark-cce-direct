                vsts(vregNorm_u0, outAddr + (i + 0) * VL_FLOAT_SIZE, 0, NORM_B32, preg0_u0);
                vsts(vregNorm_u1, outAddr + (i + 1) * VL_FLOAT_SIZE, 0, NORM_B32, preg0_u1);
