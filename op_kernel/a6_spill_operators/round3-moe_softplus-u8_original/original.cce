                vsts(vregOut_u6, outputAddr + ((i + 6) * VL_FLOAT_SIZE), 0, NORM_B32, preg0_u6);
                vsts(vregOut_u7, outputAddr + ((i + 7) * VL_FLOAT_SIZE), 0, NORM_B32, preg0_u7);
                vsts(vregZeroIdx_u0, expertIdxAddr + (i + 0) * VL_FLOAT_SIZE, 0, NORM_B32,
