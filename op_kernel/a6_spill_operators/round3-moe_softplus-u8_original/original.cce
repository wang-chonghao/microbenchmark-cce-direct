#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* inputAddr, __ubuf__ float* outputAddr,
                                    __ubuf__ int32_t* expertIdxAddr, __ubuf__ float* outAddr) {
    uint32_t rowsInBatchU32 = 3072;
    uint16_t vfLoopNum = 48;
    constexpr uint32_t VL_FLOAT_SIZE = 64;
    constexpr float LOG1P_TAYLOR_THRESHOLD = 0.00390625f;
    float eps_ = 9.999999747378752e-05f, routedScalingFactor_ = 1.25f;
    __VEC_SCOPE__ {
        vector_f32 vregIn;
        vector_f32 vregNorm;
        vector_f32 vregOut;
        vector_f32 vregSumBcast;
        vector_f32 vregAbsX;
        vector_f32 vregApprox;
        vector_f32 vregHalfT;
        vector_f32 vregOneMinusHalfT;
        vector_f32 vregOne;
        vector_f32 vregZero;
        vector_f32 vregTmp1;
        vector_f32 vregTmp2;
        vector_f32 vregTmp3;
        vector_s32 vregZeroIdx;
        vector_bool preg0 = pset_b32(PAT_ALL);
        vector_bool pregCmp = pset_b32(PAT_ALL);
        vdup(vregOne, static_cast<float>(1), preg0, MODE_ZEROING);
        vdup(vregZero, static_cast<float>(0), preg0, MODE_ZEROING);

        {
            vector_bool preg0_u0;
            vector_bool preg0_u1;
            vector_bool preg0_u2;
            vector_bool preg0_u3;
            vector_bool preg0_u4;
            vector_bool preg0_u5;
            vector_bool preg0_u6;
            vector_bool preg0_u7;
            vector_bool pregCmp_u0;
            vector_bool pregCmp_u1;
            vector_bool pregCmp_u2;
            vector_bool pregCmp_u3;
            vector_bool pregCmp_u4;
            vector_bool pregCmp_u5;
            vector_bool pregCmp_u6;
            vector_bool pregCmp_u7;
            vector_f32 vregAbsX_u0;
            vector_f32 vregAbsX_u1;
            vector_f32 vregAbsX_u2;
            vector_f32 vregAbsX_u3;
            vector_f32 vregAbsX_u4;
            vector_f32 vregAbsX_u5;
            vector_f32 vregAbsX_u6;
            vector_f32 vregAbsX_u7;
            vector_f32 vregApprox_u0;
            vector_f32 vregApprox_u1;
            vector_f32 vregApprox_u2;
            vector_f32 vregApprox_u3;
            vector_f32 vregApprox_u4;
            vector_f32 vregApprox_u5;
            vector_f32 vregApprox_u6;
            vector_f32 vregApprox_u7;
            vector_f32 vregHalfT_u0;
            vector_f32 vregHalfT_u1;
            vector_f32 vregHalfT_u2;
            vector_f32 vregHalfT_u3;
            vector_f32 vregHalfT_u4;
            vector_f32 vregHalfT_u5;
            vector_f32 vregHalfT_u6;
            vector_f32 vregHalfT_u7;
            vector_f32 vregIn_u0;
            vector_f32 vregIn_u1;
            vector_f32 vregIn_u2;
            vector_f32 vregIn_u3;
            vector_f32 vregIn_u4;
            vector_f32 vregIn_u5;
            vector_f32 vregIn_u6;
            vector_f32 vregIn_u7;
            vector_f32 vregNorm_u0;
            vector_f32 vregNorm_u1;
            vector_f32 vregNorm_u2;
            vector_f32 vregNorm_u3;
            vector_f32 vregNorm_u4;
            vector_f32 vregNorm_u5;
            vector_f32 vregNorm_u6;
            vector_f32 vregNorm_u7;
            vector_f32 vregOneMinusHalfT_u0;
            vector_f32 vregOneMinusHalfT_u1;
            vector_f32 vregOneMinusHalfT_u2;
            vector_f32 vregOneMinusHalfT_u3;
            vector_f32 vregOneMinusHalfT_u4;
            vector_f32 vregOneMinusHalfT_u5;
            vector_f32 vregOneMinusHalfT_u6;
            vector_f32 vregOneMinusHalfT_u7;
            vector_f32 vregOut_u0;
            vector_f32 vregOut_u1;
            vector_f32 vregOut_u2;
            vector_f32 vregOut_u3;
            vector_f32 vregOut_u4;
            vector_f32 vregOut_u5;
            vector_f32 vregOut_u6;
            vector_f32 vregOut_u7;
            vector_f32 vregSumBcast_u0;
            vector_f32 vregSumBcast_u1;
            vector_f32 vregSumBcast_u2;
            vector_f32 vregSumBcast_u3;
            vector_f32 vregSumBcast_u4;
            vector_f32 vregSumBcast_u5;
            vector_f32 vregSumBcast_u6;
            vector_f32 vregSumBcast_u7;
            vector_f32 vregTmp1_u0;
            vector_f32 vregTmp1_u1;
            vector_f32 vregTmp1_u2;
            vector_f32 vregTmp1_u3;
            vector_f32 vregTmp1_u4;
            vector_f32 vregTmp1_u5;
            vector_f32 vregTmp1_u6;
            vector_f32 vregTmp1_u7;
            vector_f32 vregTmp2_u0;
            vector_f32 vregTmp2_u1;
            vector_f32 vregTmp2_u2;
            vector_f32 vregTmp2_u3;
            vector_f32 vregTmp2_u4;
            vector_f32 vregTmp2_u5;
            vector_f32 vregTmp2_u6;
            vector_f32 vregTmp2_u7;
            vector_f32 vregTmp3_u0;
            vector_f32 vregTmp3_u1;
            vector_f32 vregTmp3_u2;
            vector_f32 vregTmp3_u3;
            vector_f32 vregTmp3_u4;
            vector_f32 vregTmp3_u5;
            vector_f32 vregTmp3_u6;
            vector_f32 vregTmp3_u7;
            vector_s32 vregZeroIdx_u0;
            vector_s32 vregZeroIdx_u1;
            vector_s32 vregZeroIdx_u2;
            vector_s32 vregZeroIdx_u3;
            vector_s32 vregZeroIdx_u4;
            vector_s32 vregZeroIdx_u5;
            vector_s32 vregZeroIdx_u6;
            vector_s32 vregZeroIdx_u7;
#pragma unroll 1
            for (uint32_t i = 0; i < 48; i += 8) {
                preg0_u0 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u1 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u2 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u3 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u4 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u5 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u6 = plt_b32(rowsInBatchU32, POST_UPDATE);
                preg0_u7 = plt_b32(rowsInBatchU32, POST_UPDATE);
                vlds(vregIn_u0, inputAddr + ((i + 0) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u1, inputAddr + ((i + 1) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u2, inputAddr + ((i + 2) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u3, inputAddr + ((i + 3) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u4, inputAddr + ((i + 4) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u5, inputAddr + ((i + 5) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u6, inputAddr + ((i + 6) * VL_FLOAT_SIZE), 0, NORM);
                vlds(vregIn_u7, inputAddr + ((i + 7) * VL_FLOAT_SIZE), 0, NORM);
                vabs(vregAbsX_u0, vregIn_u0, preg0_u0, MODE_ZEROING);
                vabs(vregAbsX_u1, vregIn_u1, preg0_u1, MODE_ZEROING);
                vabs(vregAbsX_u2, vregIn_u2, preg0_u2, MODE_ZEROING);
                vabs(vregAbsX_u3, vregIn_u3, preg0_u3, MODE_ZEROING);
                vabs(vregAbsX_u4, vregIn_u4, preg0_u4, MODE_ZEROING);
                vabs(vregAbsX_u5, vregIn_u5, preg0_u5, MODE_ZEROING);
                vabs(vregAbsX_u6, vregIn_u6, preg0_u6, MODE_ZEROING);
                vabs(vregAbsX_u7, vregIn_u7, preg0_u7, MODE_ZEROING);
                vmuls(vregTmp1_u0, vregAbsX_u0, static_cast<float>(-1), preg0_u0, MODE_ZEROING);
                vmuls(vregTmp1_u1, vregAbsX_u1, static_cast<float>(-1), preg0_u1, MODE_ZEROING);
                vmuls(vregTmp1_u2, vregAbsX_u2, static_cast<float>(-1), preg0_u2, MODE_ZEROING);
                vmuls(vregTmp1_u3, vregAbsX_u3, static_cast<float>(-1), preg0_u3, MODE_ZEROING);
                vmuls(vregTmp1_u4, vregAbsX_u4, static_cast<float>(-1), preg0_u4, MODE_ZEROING);
                vmuls(vregTmp1_u5, vregAbsX_u5, static_cast<float>(-1), preg0_u5, MODE_ZEROING);
                vmuls(vregTmp1_u6, vregAbsX_u6, static_cast<float>(-1), preg0_u6, MODE_ZEROING);
                vmuls(vregTmp1_u7, vregAbsX_u7, static_cast<float>(-1), preg0_u7, MODE_ZEROING);
                vexp(vregTmp1_u0, vregTmp1_u0, preg0_u0, MODE_ZEROING);
                vexp(vregTmp1_u1, vregTmp1_u1, preg0_u1, MODE_ZEROING);
                vexp(vregTmp1_u2, vregTmp1_u2, preg0_u2, MODE_ZEROING);
                vexp(vregTmp1_u3, vregTmp1_u3, preg0_u3, MODE_ZEROING);
                vexp(vregTmp1_u4, vregTmp1_u4, preg0_u4, MODE_ZEROING);
                vexp(vregTmp1_u5, vregTmp1_u5, preg0_u5, MODE_ZEROING);
                vexp(vregTmp1_u6, vregTmp1_u6, preg0_u6, MODE_ZEROING);
                vexp(vregTmp1_u7, vregTmp1_u7, preg0_u7, MODE_ZEROING);
                vcmps_lt(pregCmp_u0, vregTmp1_u0, LOG1P_TAYLOR_THRESHOLD, preg0_u0);
                vcmps_lt(pregCmp_u1, vregTmp1_u1, LOG1P_TAYLOR_THRESHOLD, preg0_u1);
                vcmps_lt(pregCmp_u2, vregTmp1_u2, LOG1P_TAYLOR_THRESHOLD, preg0_u2);
                vcmps_lt(pregCmp_u3, vregTmp1_u3, LOG1P_TAYLOR_THRESHOLD, preg0_u3);
                vcmps_lt(pregCmp_u4, vregTmp1_u4, LOG1P_TAYLOR_THRESHOLD, preg0_u4);
                vcmps_lt(pregCmp_u5, vregTmp1_u5, LOG1P_TAYLOR_THRESHOLD, preg0_u5);
                vcmps_lt(pregCmp_u6, vregTmp1_u6, LOG1P_TAYLOR_THRESHOLD, preg0_u6);
                vcmps_lt(pregCmp_u7, vregTmp1_u7, LOG1P_TAYLOR_THRESHOLD, preg0_u7);
                vmuls(vregHalfT_u0, vregTmp1_u0, static_cast<float>(0.5), preg0_u0, MODE_ZEROING);
                vmuls(vregHalfT_u1, vregTmp1_u1, static_cast<float>(0.5), preg0_u1, MODE_ZEROING);
                vmuls(vregHalfT_u2, vregTmp1_u2, static_cast<float>(0.5), preg0_u2, MODE_ZEROING);
                vmuls(vregHalfT_u3, vregTmp1_u3, static_cast<float>(0.5), preg0_u3, MODE_ZEROING);
                vmuls(vregHalfT_u4, vregTmp1_u4, static_cast<float>(0.5), preg0_u4, MODE_ZEROING);
                vmuls(vregHalfT_u5, vregTmp1_u5, static_cast<float>(0.5), preg0_u5, MODE_ZEROING);
                vmuls(vregHalfT_u6, vregTmp1_u6, static_cast<float>(0.5), preg0_u6, MODE_ZEROING);
                vmuls(vregHalfT_u7, vregTmp1_u7, static_cast<float>(0.5), preg0_u7, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u0, vregOne, vregHalfT_u0, preg0_u0, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u1, vregOne, vregHalfT_u1, preg0_u1, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u2, vregOne, vregHalfT_u2, preg0_u2, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u3, vregOne, vregHalfT_u3, preg0_u3, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u4, vregOne, vregHalfT_u4, preg0_u4, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u5, vregOne, vregHalfT_u5, preg0_u5, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u6, vregOne, vregHalfT_u6, preg0_u6, MODE_ZEROING);
                vsub(vregOneMinusHalfT_u7, vregOne, vregHalfT_u7, preg0_u7, MODE_ZEROING);
                vmul(vregApprox_u0, vregTmp1_u0, vregOneMinusHalfT_u0, preg0_u0, MODE_ZEROING);
                vmul(vregApprox_u1, vregTmp1_u1, vregOneMinusHalfT_u1, preg0_u1, MODE_ZEROING);
                vmul(vregApprox_u2, vregTmp1_u2, vregOneMinusHalfT_u2, preg0_u2, MODE_ZEROING);
                vmul(vregApprox_u3, vregTmp1_u3, vregOneMinusHalfT_u3, preg0_u3, MODE_ZEROING);
                vmul(vregApprox_u4, vregTmp1_u4, vregOneMinusHalfT_u4, preg0_u4, MODE_ZEROING);
                vmul(vregApprox_u5, vregTmp1_u5, vregOneMinusHalfT_u5, preg0_u5, MODE_ZEROING);
                vmul(vregApprox_u6, vregTmp1_u6, vregOneMinusHalfT_u6, preg0_u6, MODE_ZEROING);
                vmul(vregApprox_u7, vregTmp1_u7, vregOneMinusHalfT_u7, preg0_u7, MODE_ZEROING);
                vadds(vregTmp2_u0, vregTmp1_u0, static_cast<float>(1), preg0_u0, MODE_ZEROING);
                vadds(vregTmp2_u1, vregTmp1_u1, static_cast<float>(1), preg0_u1, MODE_ZEROING);
                vadds(vregTmp2_u2, vregTmp1_u2, static_cast<float>(1), preg0_u2, MODE_ZEROING);
                vadds(vregTmp2_u3, vregTmp1_u3, static_cast<float>(1), preg0_u3, MODE_ZEROING);
                vadds(vregTmp2_u4, vregTmp1_u4, static_cast<float>(1), preg0_u4, MODE_ZEROING);
                vadds(vregTmp2_u5, vregTmp1_u5, static_cast<float>(1), preg0_u5, MODE_ZEROING);
                vadds(vregTmp2_u6, vregTmp1_u6, static_cast<float>(1), preg0_u6, MODE_ZEROING);
                vadds(vregTmp2_u7, vregTmp1_u7, static_cast<float>(1), preg0_u7, MODE_ZEROING);
                vln(vregTmp3_u0, vregTmp2_u0, preg0_u0, MODE_ZEROING);
                vln(vregTmp3_u1, vregTmp2_u1, preg0_u1, MODE_ZEROING);
                vln(vregTmp3_u2, vregTmp2_u2, preg0_u2, MODE_ZEROING);
                vln(vregTmp3_u3, vregTmp2_u3, preg0_u3, MODE_ZEROING);
                vln(vregTmp3_u4, vregTmp2_u4, preg0_u4, MODE_ZEROING);
                vln(vregTmp3_u5, vregTmp2_u5, preg0_u5, MODE_ZEROING);
                vln(vregTmp3_u6, vregTmp2_u6, preg0_u6, MODE_ZEROING);
                vln(vregTmp3_u7, vregTmp2_u7, preg0_u7, MODE_ZEROING);
                vsel(vregTmp3_u0, vregApprox_u0, vregTmp3_u0, pregCmp_u0);
                vsel(vregTmp3_u1, vregApprox_u1, vregTmp3_u1, pregCmp_u1);
                vsel(vregTmp3_u2, vregApprox_u2, vregTmp3_u2, pregCmp_u2);
                vsel(vregTmp3_u3, vregApprox_u3, vregTmp3_u3, pregCmp_u3);
                vsel(vregTmp3_u4, vregApprox_u4, vregTmp3_u4, pregCmp_u4);
                vsel(vregTmp3_u5, vregApprox_u5, vregTmp3_u5, pregCmp_u5);
                vsel(vregTmp3_u6, vregApprox_u6, vregTmp3_u6, pregCmp_u6);
                vsel(vregTmp3_u7, vregApprox_u7, vregTmp3_u7, pregCmp_u7);
                vmax(vregTmp1_u0, vregIn_u0, vregZero, preg0_u0, MODE_ZEROING);
                vmax(vregTmp1_u1, vregIn_u1, vregZero, preg0_u1, MODE_ZEROING);
                vmax(vregTmp1_u2, vregIn_u2, vregZero, preg0_u2, MODE_ZEROING);
                vmax(vregTmp1_u3, vregIn_u3, vregZero, preg0_u3, MODE_ZEROING);
                vmax(vregTmp1_u4, vregIn_u4, vregZero, preg0_u4, MODE_ZEROING);
                vmax(vregTmp1_u5, vregIn_u5, vregZero, preg0_u5, MODE_ZEROING);
                vmax(vregTmp1_u6, vregIn_u6, vregZero, preg0_u6, MODE_ZEROING);
                vmax(vregTmp1_u7, vregIn_u7, vregZero, preg0_u7, MODE_ZEROING);
                vadd(vregNorm_u0, vregTmp1_u0, vregTmp3_u0, preg0_u0, MODE_ZEROING);
                vadd(vregNorm_u1, vregTmp1_u1, vregTmp3_u1, preg0_u1, MODE_ZEROING);
                vadd(vregNorm_u2, vregTmp1_u2, vregTmp3_u2, preg0_u2, MODE_ZEROING);
                vadd(vregNorm_u3, vregTmp1_u3, vregTmp3_u3, preg0_u3, MODE_ZEROING);
                vadd(vregNorm_u4, vregTmp1_u4, vregTmp3_u4, preg0_u4, MODE_ZEROING);
                vadd(vregNorm_u5, vregTmp1_u5, vregTmp3_u5, preg0_u5, MODE_ZEROING);
                vadd(vregNorm_u6, vregTmp1_u6, vregTmp3_u6, preg0_u6, MODE_ZEROING);
                vadd(vregNorm_u7, vregTmp1_u7, vregTmp3_u7, preg0_u7, MODE_ZEROING);
                vsqrt(vregNorm_u0, vregNorm_u0, preg0_u0, MODE_ZEROING);
                vsqrt(vregNorm_u1, vregNorm_u1, preg0_u1, MODE_ZEROING);
                vsqrt(vregNorm_u2, vregNorm_u2, preg0_u2, MODE_ZEROING);
                vsqrt(vregNorm_u3, vregNorm_u3, preg0_u3, MODE_ZEROING);
                vsqrt(vregNorm_u4, vregNorm_u4, preg0_u4, MODE_ZEROING);
                vsqrt(vregNorm_u5, vregNorm_u5, preg0_u5, MODE_ZEROING);
                vsqrt(vregNorm_u6, vregNorm_u6, preg0_u6, MODE_ZEROING);
                vsqrt(vregNorm_u7, vregNorm_u7, preg0_u7, MODE_ZEROING);
                vadds(vregSumBcast_u0, vregNorm_u0, eps_, preg0_u0, MODE_ZEROING);
                vadds(vregSumBcast_u1, vregNorm_u1, eps_, preg0_u1, MODE_ZEROING);
                vadds(vregSumBcast_u2, vregNorm_u2, eps_, preg0_u2, MODE_ZEROING);
                vadds(vregSumBcast_u3, vregNorm_u3, eps_, preg0_u3, MODE_ZEROING);
                vadds(vregSumBcast_u4, vregNorm_u4, eps_, preg0_u4, MODE_ZEROING);
                vadds(vregSumBcast_u5, vregNorm_u5, eps_, preg0_u5, MODE_ZEROING);
                vadds(vregSumBcast_u6, vregNorm_u6, eps_, preg0_u6, MODE_ZEROING);
                vadds(vregSumBcast_u7, vregNorm_u7, eps_, preg0_u7, MODE_ZEROING);
                vdiv(vregOut_u0, vregNorm_u0, vregSumBcast_u0, preg0_u0, MODE_ZEROING);
                vdiv(vregOut_u1, vregNorm_u1, vregSumBcast_u1, preg0_u1, MODE_ZEROING);
                vdiv(vregOut_u2, vregNorm_u2, vregSumBcast_u2, preg0_u2, MODE_ZEROING);
                vdiv(vregOut_u3, vregNorm_u3, vregSumBcast_u3, preg0_u3, MODE_ZEROING);
                vdiv(vregOut_u4, vregNorm_u4, vregSumBcast_u4, preg0_u4, MODE_ZEROING);
                vdiv(vregOut_u5, vregNorm_u5, vregSumBcast_u5, preg0_u5, MODE_ZEROING);
                vdiv(vregOut_u6, vregNorm_u6, vregSumBcast_u6, preg0_u6, MODE_ZEROING);
                vdiv(vregOut_u7, vregNorm_u7, vregSumBcast_u7, preg0_u7, MODE_ZEROING);
                vmuls(vregOut_u0, vregOut_u0, routedScalingFactor_, preg0_u0, MODE_ZEROING);
                vmuls(vregOut_u1, vregOut_u1, routedScalingFactor_, preg0_u1, MODE_ZEROING);
                vmuls(vregOut_u2, vregOut_u2, routedScalingFactor_, preg0_u2, MODE_ZEROING);
                vmuls(vregOut_u3, vregOut_u3, routedScalingFactor_, preg0_u3, MODE_ZEROING);
                vmuls(vregOut_u4, vregOut_u4, routedScalingFactor_, preg0_u4, MODE_ZEROING);
                vmuls(vregOut_u5, vregOut_u5, routedScalingFactor_, preg0_u5, MODE_ZEROING);
                vmuls(vregOut_u6, vregOut_u6, routedScalingFactor_, preg0_u6, MODE_ZEROING);
                vmuls(vregOut_u7, vregOut_u7, routedScalingFactor_, preg0_u7, MODE_ZEROING);
                vdup(vregZeroIdx_u0, static_cast<int32_t>(0), preg0_u0, MODE_ZEROING);
                vdup(vregZeroIdx_u1, static_cast<int32_t>(0), preg0_u1, MODE_ZEROING);
                vdup(vregZeroIdx_u2, static_cast<int32_t>(0), preg0_u2, MODE_ZEROING);
                vdup(vregZeroIdx_u3, static_cast<int32_t>(0), preg0_u3, MODE_ZEROING);
