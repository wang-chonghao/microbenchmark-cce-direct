                    vsub(expReg_u6, expReg_u6, srcReg1fp32_u6, preg, MODE_ZEROING);
                    vsub(logReg_u6, logReg_u6, subReg_u6, preg, MODE_ZEROING);
                    vmul(logReg_u6, logReg_u6, srcReg1fp32_u6, preg, MODE_ZEROING);
                    vlds(outReg_u6, outUbAddr + (i + 6) * rOnceNumAlign + repeatTimes1 * vfLen, 0,
                         NORM);
                    vadd(outReg1_u6, logReg_u6, outReg_u6, preg, MODE_ZEROING);
                    vsts(outReg1_u6, outUbAddr + (i + 6) * rOnceNumAlign + repeatTimes1 * vfLen, 0,
                         NORM_B32, preg);

                    vsts(expReg_u6, backProbAddr + (i + 6) * rOnceNumTAlign + repeatTimes1 * vfLen,
                         0, NORM_B32, preg);
                }
#pragma unroll 1
                for (uint16_t k = 0; k < tailLoopTimes; k++) {

                    vlds(srcRegfp32_u7,
                         inputUbAddr + (i + 7) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);
                    vlds(srcReg1fp32_u7,
                         labelsUbAddr + (i + 7) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);

                    vsub(subReg_u7, srcRegfp32_u7, maxReg_u7, preg, MODE_ZEROING);
