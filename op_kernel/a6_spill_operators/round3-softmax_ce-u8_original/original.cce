                    vlds(outReg_u5, outUbAddr + (i + 5) * rOnceNumAlign + repeatTimes1 * vfLen, 0,
                         NORM);
                    vadd(outReg1_u5, logReg_u5, outReg_u5, preg, MODE_ZEROING);
