}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* inputUbAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* labelsUbAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* maxUbAddr = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* sumUbAddr = (__ubuf__ float*)get_imm(24832);
    __ubuf__ float* logUbAddr = (__ubuf__ float*)get_imm(25088);
    __ubuf__ float* outUbAddr = (__ubuf__ float*)get_imm(25344);
    __ubuf__ float* backProbAddr = (__ubuf__ float*)get_imm(37632);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 37632, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(inputUbAddr, labelsUbAddr, maxUbAddr, sumUbAddr, logUbAddr, outUbAddr,
                 backProbAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)outUbAddr, 0, 1, 12288, 0, 0, 0);
    copy_ubuf_to_gm_align_v2(output + 12288, (__ubuf__ uint8_t*)backProbAddr, 0, 1, 12288, 0, 0, 0);
}
