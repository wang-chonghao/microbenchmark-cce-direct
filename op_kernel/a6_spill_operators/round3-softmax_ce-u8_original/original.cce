                }
#pragma unroll 1
                for (uint16_t k = 0; k < tailLoopTimes; k++) {

                    vlds(srcRegfp32_u4,
                         inputUbAddr + (i + 4) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);
                    vlds(srcReg1fp32_u4,
                         labelsUbAddr + (i + 4) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);

