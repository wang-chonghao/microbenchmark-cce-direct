                    vsts(expReg_u5, backProbAddr + (i + 5) * rOnceNumTAlign + repeatTimes1 * vfLen,
                         0, NORM_B32, preg);
                }
#pragma unroll 1
                for (uint16_t k = 0; k < tailLoopTimes; k++) {

                    vlds(srcRegfp32_u6,
                         inputUbAddr + (i + 6) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);
                    vlds(srcReg1fp32_u6,
                         labelsUbAddr + (i + 6) * rOnceNumTAlign + repeatTimes1 * vfLen, 0, NORM);

                    vsub(subReg_u6, srcRegfp32_u6, maxReg_u6, preg, MODE_ZEROING);
