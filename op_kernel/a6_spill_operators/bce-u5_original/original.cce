#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* xAddr, __ubuf__ float* yAddr,
                                    __ubuf__ float* weightAddr, __ubuf__ float* posWeightAddr,
                                    __ubuf__ float* lossAddr) {
    uint32_t oneRepeat = 64, totalLen = 1024, repeatTimes = 16;
    __VEC_SCOPE__ {
        vector_bool pregUp;
        vector_f32 regX;
        vector_f32 regY;
        vector_f32 regWeight;
        vector_f32 regPosWeight;
        vector_f32 regLoss;

        vector_f32 regMinVal;
        vector_f32 regAbsX;
        vector_f32 regNegAbsX;
        vector_f32 regExpNegAbsX;
        vector_f32 regOneAddExp;
        vector_f32 regLog;
        vector_f32 regLogSigmoid;
        vector_f32 regPWSubOne;
        vector_f32 regPWSubOneMulY;
        vector_f32 regPWSubOneMulYAddOne;
        vector_f32 regOneSubY;
        vector_f32 regOneSubYMulX;

        vector_f32 regOne;

        {
            vector_bool pregUp_u0;
            vector_bool pregUp_u1;
            vector_bool pregUp_u2;
            vector_bool pregUp_u3;
            vector_bool pregUp_u4;
            vector_f32 regAbsX_u0;
            vector_f32 regAbsX_u1;
            vector_f32 regAbsX_u2;
            vector_f32 regAbsX_u3;
            vector_f32 regAbsX_u4;
            vector_f32 regExpNegAbsX_u0;
            vector_f32 regExpNegAbsX_u1;
            vector_f32 regExpNegAbsX_u2;
            vector_f32 regExpNegAbsX_u3;
            vector_f32 regExpNegAbsX_u4;
            vector_f32 regLog_u0;
            vector_f32 regLog_u1;
            vector_f32 regLog_u2;
            vector_f32 regLog_u3;
            vector_f32 regLog_u4;
            vector_f32 regLogSigmoid_u0;
            vector_f32 regLogSigmoid_u1;
            vector_f32 regLogSigmoid_u2;
            vector_f32 regLogSigmoid_u3;
            vector_f32 regLogSigmoid_u4;
            vector_f32 regLoss_u0;
            vector_f32 regLoss_u1;
            vector_f32 regLoss_u2;
            vector_f32 regLoss_u3;
            vector_f32 regLoss_u4;
            vector_f32 regMinVal_u0;
            vector_f32 regMinVal_u1;
            vector_f32 regMinVal_u2;
            vector_f32 regMinVal_u3;
            vector_f32 regMinVal_u4;
            vector_f32 regNegAbsX_u0;
            vector_f32 regNegAbsX_u1;
            vector_f32 regNegAbsX_u2;
            vector_f32 regNegAbsX_u3;
            vector_f32 regNegAbsX_u4;
            vector_f32 regOne_u0;
            vector_f32 regOne_u1;
            vector_f32 regOne_u2;
            vector_f32 regOne_u3;
            vector_f32 regOne_u4;
            vector_f32 regOneAddExp_u0;
            vector_f32 regOneAddExp_u1;
            vector_f32 regOneAddExp_u2;
            vector_f32 regOneAddExp_u3;
            vector_f32 regOneAddExp_u4;
            vector_f32 regOneSubY_u0;
            vector_f32 regOneSubY_u1;
            vector_f32 regOneSubY_u2;
            vector_f32 regOneSubY_u3;
            vector_f32 regOneSubY_u4;
            vector_f32 regOneSubYMulX_u0;
            vector_f32 regOneSubYMulX_u1;
            vector_f32 regOneSubYMulX_u2;
            vector_f32 regOneSubYMulX_u3;
            vector_f32 regOneSubYMulX_u4;
            vector_f32 regPWSubOne_u0;
            vector_f32 regPWSubOne_u1;
            vector_f32 regPWSubOne_u2;
            vector_f32 regPWSubOne_u3;
            vector_f32 regPWSubOne_u4;
            vector_f32 regPWSubOneMulY_u0;
            vector_f32 regPWSubOneMulY_u1;
            vector_f32 regPWSubOneMulY_u2;
            vector_f32 regPWSubOneMulY_u3;
            vector_f32 regPWSubOneMulY_u4;
            vector_f32 regPWSubOneMulYAddOne_u0;
            vector_f32 regPWSubOneMulYAddOne_u1;
            vector_f32 regPWSubOneMulYAddOne_u2;
            vector_f32 regPWSubOneMulYAddOne_u3;
            vector_f32 regPWSubOneMulYAddOne_u4;
            vector_f32 regPosWeight_u0;
            vector_f32 regPosWeight_u1;
            vector_f32 regPosWeight_u2;
            vector_f32 regPosWeight_u3;
            vector_f32 regPosWeight_u4;
            vector_f32 regWeight_u0;
            vector_f32 regWeight_u1;
            vector_f32 regWeight_u2;
            vector_f32 regWeight_u3;
            vector_f32 regWeight_u4;
            vector_f32 regX_u0;
            vector_f32 regX_u1;
            vector_f32 regX_u2;
            vector_f32 regX_u3;
            vector_f32 regX_u4;
            vector_f32 regY_u0;
            vector_f32 regY_u1;
            vector_f32 regY_u2;
            vector_f32 regY_u3;
            vector_f32 regY_u4;
#pragma unroll 1
            for (uint16_t loop = 0; loop < 15; loop += 5) {
                pregUp_u0 = plt_b32(totalLen, POST_UPDATE);
                pregUp_u1 = plt_b32(totalLen, POST_UPDATE);
                pregUp_u2 = plt_b32(totalLen, POST_UPDATE);
                pregUp_u3 = plt_b32(totalLen, POST_UPDATE);
                pregUp_u4 = plt_b32(totalLen, POST_UPDATE);
                vdup(regOne_u0, (float)1.0f, pregUp_u0, MODE_ZEROING);
                vdup(regOne_u1, (float)1.0f, pregUp_u1, MODE_ZEROING);
                vdup(regOne_u2, (float)1.0f, pregUp_u2, MODE_ZEROING);
                vdup(regOne_u3, (float)1.0f, pregUp_u3, MODE_ZEROING);
                vdup(regOne_u4, (float)1.0f, pregUp_u4, MODE_ZEROING);
                vlds(regX_u0, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regX_u1, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regX_u2, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regX_u3, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regX_u4, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY_u0, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY_u1, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY_u2, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY_u3, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY_u4, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regWeight_u0, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regWeight_u1, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regWeight_u2, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regWeight_u3, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regWeight_u4, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regPosWeight_u0, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regPosWeight_u1, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regPosWeight_u2, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regPosWeight_u3, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regPosWeight_u4, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vmins(regMinVal_u0, regX_u0, (float)0.0f, pregUp_u0, MODE_ZEROING);
                vmins(regMinVal_u1, regX_u1, (float)0.0f, pregUp_u1, MODE_ZEROING);
                vmins(regMinVal_u2, regX_u2, (float)0.0f, pregUp_u2, MODE_ZEROING);
                vmins(regMinVal_u3, regX_u3, (float)0.0f, pregUp_u3, MODE_ZEROING);
                vmins(regMinVal_u4, regX_u4, (float)0.0f, pregUp_u4, MODE_ZEROING);
                vabs(regAbsX_u0, regX_u0, pregUp_u0, MODE_ZEROING);
                vabs(regAbsX_u1, regX_u1, pregUp_u1, MODE_ZEROING);
                vabs(regAbsX_u2, regX_u2, pregUp_u2, MODE_ZEROING);
                vabs(regAbsX_u3, regX_u3, pregUp_u3, MODE_ZEROING);
                vabs(regAbsX_u4, regX_u4, pregUp_u4, MODE_ZEROING);
                vmuls(regNegAbsX_u0, regAbsX_u0, -1.0f, pregUp_u0, MODE_ZEROING);
                vmuls(regNegAbsX_u1, regAbsX_u1, -1.0f, pregUp_u1, MODE_ZEROING);
                vmuls(regNegAbsX_u2, regAbsX_u2, -1.0f, pregUp_u2, MODE_ZEROING);
                vmuls(regNegAbsX_u3, regAbsX_u3, -1.0f, pregUp_u3, MODE_ZEROING);
                vmuls(regNegAbsX_u4, regAbsX_u4, -1.0f, pregUp_u4, MODE_ZEROING);
                vexp(regExpNegAbsX_u0, regNegAbsX_u0, pregUp_u0, MODE_ZEROING);
                vexp(regExpNegAbsX_u1, regNegAbsX_u1, pregUp_u1, MODE_ZEROING);
                vexp(regExpNegAbsX_u2, regNegAbsX_u2, pregUp_u2, MODE_ZEROING);
                vexp(regExpNegAbsX_u3, regNegAbsX_u3, pregUp_u3, MODE_ZEROING);
                vexp(regExpNegAbsX_u4, regNegAbsX_u4, pregUp_u4, MODE_ZEROING);
                vadds(regOneAddExp_u0, regExpNegAbsX_u0, (float)1.0f, pregUp_u0, MODE_ZEROING);
                vadds(regOneAddExp_u1, regExpNegAbsX_u1, (float)1.0f, pregUp_u1, MODE_ZEROING);
                vadds(regOneAddExp_u2, regExpNegAbsX_u2, (float)1.0f, pregUp_u2, MODE_ZEROING);
                vadds(regOneAddExp_u3, regExpNegAbsX_u3, (float)1.0f, pregUp_u3, MODE_ZEROING);
                vadds(regOneAddExp_u4, regExpNegAbsX_u4, (float)1.0f, pregUp_u4, MODE_ZEROING);
                vln(regLog_u0, regOneAddExp_u0, pregUp_u0, MODE_ZEROING);
                vln(regLog_u1, regOneAddExp_u1, pregUp_u1, MODE_ZEROING);
                vln(regLog_u2, regOneAddExp_u2, pregUp_u2, MODE_ZEROING);
                vln(regLog_u3, regOneAddExp_u3, pregUp_u3, MODE_ZEROING);
                vln(regLog_u4, regOneAddExp_u4, pregUp_u4, MODE_ZEROING);
                vsub(regLogSigmoid_u0, regMinVal_u0, regLog_u0, pregUp_u0, MODE_ZEROING);
                vsub(regLogSigmoid_u1, regMinVal_u1, regLog_u1, pregUp_u1, MODE_ZEROING);
                vsub(regLogSigmoid_u2, regMinVal_u2, regLog_u2, pregUp_u2, MODE_ZEROING);
                vsub(regLogSigmoid_u3, regMinVal_u3, regLog_u3, pregUp_u3, MODE_ZEROING);
                vsub(regLogSigmoid_u4, regMinVal_u4, regLog_u4, pregUp_u4, MODE_ZEROING);
                vsub(regPWSubOne_u0, regPosWeight_u0, regOne_u0, pregUp_u0, MODE_ZEROING);
                vsub(regPWSubOne_u1, regPosWeight_u1, regOne_u1, pregUp_u1, MODE_ZEROING);
                vsub(regPWSubOne_u2, regPosWeight_u2, regOne_u2, pregUp_u2, MODE_ZEROING);
                vsub(regPWSubOne_u3, regPosWeight_u3, regOne_u3, pregUp_u3, MODE_ZEROING);
                vsub(regPWSubOne_u4, regPosWeight_u4, regOne_u4, pregUp_u4, MODE_ZEROING);
                vmul(regPWSubOneMulY_u0, regPWSubOne_u0, regY_u0, pregUp_u0, MODE_ZEROING);
                vmul(regPWSubOneMulY_u1, regPWSubOne_u1, regY_u1, pregUp_u1, MODE_ZEROING);
                vmul(regPWSubOneMulY_u2, regPWSubOne_u2, regY_u2, pregUp_u2, MODE_ZEROING);
                vmul(regPWSubOneMulY_u3, regPWSubOne_u3, regY_u3, pregUp_u3, MODE_ZEROING);
                vmul(regPWSubOneMulY_u4, regPWSubOne_u4, regY_u4, pregUp_u4, MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u0, regPWSubOneMulY_u0, (float)1.0f, pregUp_u0,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u1, regPWSubOneMulY_u1, (float)1.0f, pregUp_u1,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u2, regPWSubOneMulY_u2, (float)1.0f, pregUp_u2,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u3, regPWSubOneMulY_u3, (float)1.0f, pregUp_u3,
                      MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne_u4, regPWSubOneMulY_u4, (float)1.0f, pregUp_u4,
                      MODE_ZEROING);
                vmul(regLogSigmoid_u0, regLogSigmoid_u0, regPWSubOneMulYAddOne_u0, pregUp_u0,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u1, regLogSigmoid_u1, regPWSubOneMulYAddOne_u1, pregUp_u1,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u2, regLogSigmoid_u2, regPWSubOneMulYAddOne_u2, pregUp_u2,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u3, regLogSigmoid_u3, regPWSubOneMulYAddOne_u3, pregUp_u3,
                     MODE_ZEROING);
                vmul(regLogSigmoid_u4, regLogSigmoid_u4, regPWSubOneMulYAddOne_u4, pregUp_u4,
                     MODE_ZEROING);
                vsub(regOneSubY_u0, regOne_u0, regY_u0, pregUp_u0, MODE_ZEROING);
                vsub(regOneSubY_u1, regOne_u1, regY_u1, pregUp_u1, MODE_ZEROING);
                vsub(regOneSubY_u2, regOne_u2, regY_u2, pregUp_u2, MODE_ZEROING);
                vsub(regOneSubY_u3, regOne_u3, regY_u3, pregUp_u3, MODE_ZEROING);
                vsub(regOneSubY_u4, regOne_u4, regY_u4, pregUp_u4, MODE_ZEROING);
                vmul(regOneSubYMulX_u0, regOneSubY_u0, regX_u0, pregUp_u0, MODE_ZEROING);
                vmul(regOneSubYMulX_u1, regOneSubY_u1, regX_u1, pregUp_u1, MODE_ZEROING);
                vmul(regOneSubYMulX_u2, regOneSubY_u2, regX_u2, pregUp_u2, MODE_ZEROING);
                vmul(regOneSubYMulX_u3, regOneSubY_u3, regX_u3, pregUp_u3, MODE_ZEROING);
                vmul(regOneSubYMulX_u4, regOneSubY_u4, regX_u4, pregUp_u4, MODE_ZEROING);
                vsub(regLoss_u0, regOneSubYMulX_u0, regLogSigmoid_u0, pregUp_u0, MODE_ZEROING);
                vsub(regLoss_u1, regOneSubYMulX_u1, regLogSigmoid_u1, pregUp_u1, MODE_ZEROING);
                vsub(regLoss_u2, regOneSubYMulX_u2, regLogSigmoid_u2, pregUp_u2, MODE_ZEROING);
                vsub(regLoss_u3, regOneSubYMulX_u3, regLogSigmoid_u3, pregUp_u3, MODE_ZEROING);
                vsub(regLoss_u4, regOneSubYMulX_u4, regLogSigmoid_u4, pregUp_u4, MODE_ZEROING);
                vmul(regLoss_u0, regLoss_u0, regWeight_u0, pregUp_u0, MODE_ZEROING);
                vmul(regLoss_u1, regLoss_u1, regWeight_u1, pregUp_u1, MODE_ZEROING);
                vmul(regLoss_u2, regLoss_u2, regWeight_u2, pregUp_u2, MODE_ZEROING);
                vmul(regLoss_u3, regLoss_u3, regWeight_u3, pregUp_u3, MODE_ZEROING);
                vmul(regLoss_u4, regLoss_u4, regWeight_u4, pregUp_u4, MODE_ZEROING);
                vsts(regLoss_u0, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u0, POST_UPDATE);
                vsts(regLoss_u1, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u1, POST_UPDATE);
                vsts(regLoss_u2, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u2, POST_UPDATE);
                vsts(regLoss_u3, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u3, POST_UPDATE);
                vsts(regLoss_u4, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp_u4, POST_UPDATE);
            }
#pragma unroll 1
            for (uint16_t loop = 15; loop < 16; ++loop) {

                pregUp = plt_b32(totalLen, POST_UPDATE);
                vdup(regOne, (float)1.0f, pregUp, MODE_ZEROING);
                vlds(regX, xAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);
                vlds(regY, yAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);

                vlds(regWeight, weightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);

                vlds(regPosWeight, posWeightAddr, (int32_t)oneRepeat, NORM, POST_UPDATE);

                vmins(regMinVal, regX, (float)0.0f, pregUp, MODE_ZEROING);
                vabs(regAbsX, regX, pregUp, MODE_ZEROING);
                vmuls(regNegAbsX, regAbsX, -1.0f, pregUp, MODE_ZEROING);
                vexp(regExpNegAbsX, regNegAbsX, pregUp, MODE_ZEROING);
                vadds(regOneAddExp, regExpNegAbsX, (float)1.0f, pregUp, MODE_ZEROING);
                vln(regLog, regOneAddExp, pregUp, MODE_ZEROING);

                vsub(regLogSigmoid, regMinVal, regLog, pregUp, MODE_ZEROING);

                vsub(regPWSubOne, regPosWeight, regOne, pregUp, MODE_ZEROING);
                vmul(regPWSubOneMulY, regPWSubOne, regY, pregUp, MODE_ZEROING);
                vadds(regPWSubOneMulYAddOne, regPWSubOneMulY, (float)1.0f, pregUp, MODE_ZEROING);
                vmul(regLogSigmoid, regLogSigmoid, regPWSubOneMulYAddOne, pregUp, MODE_ZEROING);

                vsub(regOneSubY, regOne, regY, pregUp, MODE_ZEROING);
                vmul(regOneSubYMulX, regOneSubY, regX, pregUp, MODE_ZEROING);
                vsub(regLoss, regOneSubYMulX, regLogSigmoid, pregUp, MODE_ZEROING);

                vmul(regLoss, regLoss, regWeight, pregUp, MODE_ZEROING);

                vsts(regLoss, lossAddr, (int32_t)oneRepeat, NORM_B32, pregUp, POST_UPDATE);
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* xAddr = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* yAddr = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* weightAddr = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* posWeightAddr = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* lossAddr = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, yAddr, weightAddr, posWeightAddr, lossAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)lossAddr, 0, 1, 4096, 0, 0, 0);
}
