#include <stdint.h>
#ifndef __aicore__
#define __aicore__ [aicore]
#endif
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* in_, __ubuf__ float* cos, __ubuf__ float* sin,
                                    __ubuf__ float* out) {
    uint16_t sLength = 48, bLength = 1, nLength = 1;
    int64_t d = 128, dAlign = 128, ubFactorS = 48, ubFactorN = 1;
    constexpr uint32_t HALF_COEF = 2, VL_FLOAT32_SIZE = 64;

    uint32_t dHalfSize = d / HALF_COEF;
    uint16_t dLoopCount = (dHalfSize + VL_FLOAT32_SIZE - 1) / VL_FLOAT32_SIZE;
    uint32_t dHalfOffset = dAlign / HALF_COEF;

    int32_t bStepUb = ubFactorN * ubFactorS * dAlign;
    int32_t nStepUb = ubFactorS * dAlign;

    __VEC_SCOPE__ {
        vector_f32 inPart1Reg, inPart2Reg, cosPart1Reg, cosPart2Reg, sinPart1Reg, sinPart2Reg;
        vector_bool pregLoop;
        __ubuf__ float *currInUb, *currOutUb, *currSinUb, *currCosUb;
#pragma unroll 1
        for (uint16_t bIdx = 0; bIdx < bLength; bIdx++) {
#pragma unroll 1
            for (uint16_t nIdx = 0; nIdx < nLength; nIdx++) {
#pragma unroll 1
                for (uint16_t sIdx = 0; sIdx < sLength; sIdx++) {
                    uint32_t count = dHalfSize;
                    currInUb = in_ + bIdx * bStepUb + nIdx * nStepUb + sIdx * dAlign;
                    currOutUb = out + bIdx * bStepUb + nIdx * nStepUb + sIdx * dAlign;

                    currCosUb = cos + bIdx * nStepUb + sIdx * dAlign;
                    currSinUb = sin + bIdx * nStepUb + sIdx * dAlign;

#pragma unroll 1

                    for (uint16_t i = 0; i < dLoopCount; i++) {
                        pregLoop = plt_b32(count, POST_UPDATE);
                        vlds(inPart1Reg, currInUb + (i * VL_FLOAT32_SIZE), 0, NORM);
                        vlds(inPart2Reg, currInUb + (i * VL_FLOAT32_SIZE + dHalfOffset), 0, NORM);
                        vlds(cosPart1Reg, currCosUb + (i * VL_FLOAT32_SIZE), 0, NORM);
                        vlds(cosPart2Reg, currCosUb + (i * VL_FLOAT32_SIZE + dHalfOffset), 0, NORM);
                        vlds(sinPart1Reg, currSinUb + (i * VL_FLOAT32_SIZE), 0, NORM);
                        vlds(sinPart2Reg, currSinUb + (i * VL_FLOAT32_SIZE + dHalfOffset), 0, NORM);
                        vmul(cosPart1Reg, inPart1Reg, cosPart1Reg, pregLoop, MODE_ZEROING);
                        vmul(sinPart2Reg, sinPart2Reg, inPart2Reg, pregLoop, MODE_ZEROING);
                        vadd(cosPart1Reg, cosPart1Reg, sinPart2Reg, pregLoop, MODE_ZEROING);
                        vmul(cosPart2Reg, inPart2Reg, cosPart2Reg, pregLoop, MODE_ZEROING);
                        vmul(sinPart1Reg, inPart1Reg, sinPart1Reg, pregLoop, MODE_ZEROING);
                        vsub(cosPart2Reg, cosPart2Reg, sinPart1Reg, pregLoop, MODE_ZEROING);
                        vsts(cosPart1Reg, currOutUb + (i * VL_FLOAT32_SIZE), 0, NORM_B32, pregLoop);
                        vsts(cosPart2Reg, currOutUb + (i * VL_FLOAT32_SIZE + dHalfOffset), 0,
                             NORM_B32, pregLoop);
                    }
                }
            }
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* in_ = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* cos = (__ubuf__ float*)get_imm(24576);
    __ubuf__ float* sin = (__ubuf__ float*)get_imm(49152);
    __ubuf__ float* out = (__ubuf__ float*)get_imm(73728);
    nddma_desc a6_desc(nddma_desc::loop_desc(18432, 1, 1));
    nddma_out_to_ub((__ubuf__ uint32_t*)get_imm(0), (__gm__ uint32_t*)input, 0, a6_desc, 0, NEAREST_PADDING, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(in_, cos, sin, out);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    pipe_barrier(PIPE_ALL);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    __ubuf__ uint32_t* a6_offsets = (__ubuf__ uint32_t*)get_imm(0);
    a6_offsets[0] = 0;
    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    scatter_ubuf_to_gm((__gm__ uint32_t*)(output + 0), (__ubuf__ uint32_t*)out, 0, 0, a6_offsets, 0, 24576, 0, 1);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
