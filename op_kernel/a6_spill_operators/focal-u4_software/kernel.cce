extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* pSrc = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* pFloorSrc = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* qGammaSrc = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* qGamma1Src = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(16384);
    nddma_desc a6_desc(nddma_desc::loop_desc(4096, 1, 1));
    nddma_out_to_ub((__ubuf__ uint32_t*)get_imm(0), (__gm__ uint32_t*)input, 0, a6_desc, 0, NEAREST_PADDING, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(pSrc, pFloorSrc, qGammaSrc, qGamma1Src, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    pipe_barrier(PIPE_ALL);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    __ubuf__ uint32_t* a6_offsets = (__ubuf__ uint32_t*)get_imm(0);
    a6_offsets[0] = 0;
    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID1);
    scatter_ubuf_to_gm((__gm__ uint32_t*)(output + 0), (__ubuf__ uint32_t*)dst, 0, 0, a6_offsets, 0, 4096, 0, 1);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
