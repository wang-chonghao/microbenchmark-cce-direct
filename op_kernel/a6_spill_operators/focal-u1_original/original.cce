#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ float* pSrc, __ubuf__ float* pFloorSrc,
                                    __ubuf__ float* qGammaSrc, __ubuf__ float* qGamma1Src,
                                    __ubuf__ float* dst) {
    float alpha = 0.25f, gamma = 2.0f;
    uint32_t count = 1024;
    uint16_t repeatTimes = 16;
    __VEC_SCOPE__ {
        constexpr uint32_t kVl = 256 / sizeof(float);
        constexpr float kMinNormal = 1.17549435e-38f;
        constexpr float kMaxFloat = 3.402823466e+38f;
        vector_f32 p, q, pFloor, qGamma, qGamma1, logP, reconstructed, corrected, original, lhs,
            rhs;
        vector_f32 absOriginal, absLhs, absRhs, maxTerm, cancellationLimit;
        vector_bool mask, cancellation, nonzeroTerms, qNormal, qGamma1Normal, qGamma1Finite;
        uint32_t remaining = count;
        for (uint16_t i = 0; i < repeatTimes; ++i) {
            const int32_t off = static_cast<int32_t>(i) * kVl;
            mask = plt_b32(remaining, POST_UPDATE);
            vlds(p, pSrc + off, 0, NORM);
            vlds(pFloor, pFloorSrc + off, 0, NORM);
            vlds(qGamma, qGammaSrc + off, 0, NORM);
            vlds(qGamma1, qGamma1Src + off, 0, NORM);
            vln(logP, pFloor, mask, MODE_ZEROING);
            vmuls(q, p, -1.0f, mask, MODE_ZEROING);
            vadds(q, q, 1.0f, mask, MODE_ZEROING);
            vmul(lhs, qGamma, logP, mask, MODE_ZEROING);
            vmul(lhs, lhs, p, mask, MODE_ZEROING);
            vmuls(lhs, lhs, gamma * alpha, mask, MODE_ZEROING);
            vmuls(rhs, qGamma1, alpha, mask, MODE_ZEROING);
            vsub(original, lhs, rhs, mask, MODE_ZEROING);
            vdiv(reconstructed, qGamma1, q, mask, MODE_ZEROING);
            vmul(corrected, reconstructed, logP, mask, MODE_ZEROING);
            vmul(corrected, corrected, p, mask, MODE_ZEROING);
            vmuls(corrected, corrected, gamma * alpha, mask, MODE_ZEROING);
            vsub(corrected, corrected, rhs, mask, MODE_ZEROING);
            vabs(absOriginal, original, mask, MODE_ZEROING);
            vabs(absLhs, lhs, mask, MODE_ZEROING);
            vabs(absRhs, rhs, mask, MODE_ZEROING);
            vmax(maxTerm, absLhs, absRhs, mask, MODE_ZEROING);
            vmuls(cancellationLimit, maxTerm, 0.015625f, mask, MODE_ZEROING);
            vcmp_le(cancellation, absOriginal, cancellationLimit, mask);
            vcmps_gt(nonzeroTerms, maxTerm, kMinNormal, mask);
            vcmps_gt(qNormal, q, kMinNormal, mask);
            vcmps_gt(qGamma1Normal, qGamma1, kMinNormal, mask);
            vcmps_le(qGamma1Finite, qGamma1, kMaxFloat, mask);
            vsel(corrected, corrected, original, cancellation);
            vsel(corrected, corrected, original, nonzeroTerms);
            vsel(corrected, corrected, original, qNormal);
            vsel(corrected, corrected, original, qGamma1Normal);
            vsel(corrected, corrected, original, qGamma1Finite);
            vsts(corrected, dst + off, 0, NORM_B32, mask);
        }
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ float* pSrc = (__ubuf__ float*)get_imm(0);
    __ubuf__ float* pFloorSrc = (__ubuf__ float*)get_imm(4096);
    __ubuf__ float* qGammaSrc = (__ubuf__ float*)get_imm(8192);
    __ubuf__ float* qGamma1Src = (__ubuf__ float*)get_imm(12288);
    __ubuf__ float* dst = (__ubuf__ float*)get_imm(16384);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 16384, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(pSrc, pFloorSrc, qGammaSrc, qGamma1Src, dst);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)dst, 0, 1, 4096, 0, 0, 0);
}
