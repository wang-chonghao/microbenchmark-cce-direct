#include "kernel_operator.h"
#include <cfloat>
#include <type_traits>
__aicore__ inline void candidate_vf(__ubuf__ half* xAddr, __ubuf__ half* weightAddr,
                                    __ubuf__ half* yAddr) {
    uint32_t xLoopNum = 24, dimLen = 192;
    constexpr uint32_t B32_REP_SIZE = 64;
    __VEC_SCOPE__ {

        vector_f32 weight11B32, weight12B32, weight13B32, x11B32, x12B32, x13B32, mul11B32,
            mul12B32, mul13B32, y1B32;
        vector_f32 weight21B32, weight22B32, weight23B32, x21B32, x22B32, x23B32, mul21B32,
            mul22B32, mul23B32, y2B32;
        vector_f32 x31B32, x32B32, x33B32, mul31B32, mul32B32, mul33B32, y3B32;
        vector_f32 x41B32, x42B32, x43B32, mul41B32, mul42B32, mul43B32, y4B32;
        vector_f16 weight11B16, weight12B16, weight13B16, x11B16, x12B16, x13B16, y1B16;
        vector_f16 weight21B16, weight22B16, weight23B16, x21B16, x22B16, x23B16, y2B16;
        vector_f16 x31B16, x32B16, x33B16, y3B16;
        vector_f16 x41B16, x42B16, x43B16, y4B16;
        uint8_t dimLoopNum = dimLen / (B32_REP_SIZE * 2);
        uint8_t dimRem = dimLen - dimLoopNum * B32_REP_SIZE * 2;
        vector_bool maskB32 = pset_b32(PAT_ALL);
        vector_bool maskRem;
        int32_t offset = 0;
#pragma unroll 1
        for (uint8_t dimLoop = 0; dimLoop < dimLoopNum; dimLoop++) {
            vlds(weight11B16, weightAddr + offset, 0, UNPK_B16);
            vlds(weight12B16, weightAddr + offset + dimLen, 0, UNPK_B16);
            vlds(weight13B16, weightAddr + offset + 2 * dimLen, 0, UNPK_B16);
            vcvt(weight11B32, weight11B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(weight12B32, weight12B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(weight13B32, weight13B16, maskB32, PART_EVEN, MODE_ZEROING);
            vlds(weight21B16, weightAddr + offset + B32_REP_SIZE, 0, UNPK_B16);
            vlds(weight22B16, weightAddr + offset + B32_REP_SIZE + dimLen, 0, UNPK_B16);
            vlds(weight23B16, weightAddr + offset + B32_REP_SIZE + 2 * dimLen, 0, UNPK_B16);
            vcvt(weight21B32, weight21B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(weight22B32, weight22B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(weight23B32, weight23B16, maskB32, PART_EVEN, MODE_ZEROING);
#pragma unroll 1
            for (uint32_t xLoop = 0; xLoop < xLoopNum; xLoop++) {
                vdup(y1B32, 0, maskB32, MODE_ZEROING);
                vdup(y2B32, 0, maskB32, MODE_ZEROING);
                vdup(y3B32, 0, maskB32, MODE_ZEROING);
                vdup(y4B32, 0, maskB32, MODE_ZEROING);
                vlds(x11B16, xAddr + offset + 2 * xLoop * dimLen, 0, UNPK_B16);
                vlds(x12B16, xAddr + offset + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
                vlds(x13B16, xAddr + offset + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
                vlds(x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen, 0, UNPK_B16);
                vlds(x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
                vlds(x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
                vlds(x31B16, xAddr + offset + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
                vlds(x32B16, xAddr + offset + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
                vlds(x33B16, xAddr + offset + (2 * xLoop + 3) * dimLen, 0, UNPK_B16);
                vlds(x41B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
                vlds(x42B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
                vlds(x43B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 3) * dimLen, 0, UNPK_B16);
                vcvt(x11B32, x11B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x12B32, x12B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x13B32, x13B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x21B32, x21B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x22B32, x22B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x23B32, x23B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x31B32, x31B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x32B32, x32B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x33B32, x33B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x41B32, x41B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x42B32, x42B16, maskB32, PART_EVEN, MODE_ZEROING);
                vcvt(x43B32, x43B16, maskB32, PART_EVEN, MODE_ZEROING);
                vmul(mul11B32, x11B32, weight11B32, maskB32, MODE_ZEROING);
                vmul(mul12B32, x12B32, weight12B32, maskB32, MODE_ZEROING);
                vmul(mul13B32, x13B32, weight13B32, maskB32, MODE_ZEROING);
                vmul(mul21B32, x21B32, weight21B32, maskB32, MODE_ZEROING);
                vmul(mul22B32, x22B32, weight22B32, maskB32, MODE_ZEROING);
                vmul(mul23B32, x23B32, weight23B32, maskB32, MODE_ZEROING);
                vmul(mul31B32, x31B32, weight11B32, maskB32, MODE_ZEROING);
                vmul(mul32B32, x32B32, weight12B32, maskB32, MODE_ZEROING);
                vmul(mul33B32, x33B32, weight13B32, maskB32, MODE_ZEROING);
                vmul(mul41B32, x41B32, weight21B32, maskB32, MODE_ZEROING);
                vmul(mul42B32, x42B32, weight22B32, maskB32, MODE_ZEROING);
                vmul(mul43B32, x43B32, weight23B32, maskB32, MODE_ZEROING);

                vadd(y1B32, y1B32, mul11B32, maskB32, MODE_ZEROING);
                vadd(y1B32, y1B32, mul12B32, maskB32, MODE_ZEROING);
                vadd(y1B32, y1B32, mul13B32, maskB32, MODE_ZEROING);
                vadd(y1B32, y1B32, x13B32, maskB32, MODE_ZEROING);
                vadd(y2B32, y2B32, mul21B32, maskB32, MODE_ZEROING);
                vadd(y2B32, y2B32, mul22B32, maskB32, MODE_ZEROING);
                vadd(y2B32, y2B32, mul23B32, maskB32, MODE_ZEROING);
                vadd(y2B32, y2B32, x23B32, maskB32, MODE_ZEROING);
                vadd(y3B32, y3B32, mul31B32, maskB32, MODE_ZEROING);
                vadd(y3B32, y3B32, mul32B32, maskB32, MODE_ZEROING);
                vadd(y3B32, y3B32, mul33B32, maskB32, MODE_ZEROING);
                vadd(y3B32, y3B32, x33B32, maskB32, MODE_ZEROING);
                vadd(y4B32, y4B32, mul41B32, maskB32, MODE_ZEROING);
                vadd(y4B32, y4B32, mul42B32, maskB32, MODE_ZEROING);
                vadd(y4B32, y4B32, mul43B32, maskB32, MODE_ZEROING);
                vadd(y4B32, y4B32, x43B32, maskB32, MODE_ZEROING);
                vcvt(y1B16, y1B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
                vcvt(y2B16, y2B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
                vcvt(y3B16, y3B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
                vcvt(y4B16, y4B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
                vsts(y1B16, yAddr + offset + 2 * xLoop * dimLen, 0, PK_B32, maskB32);
                vsts(y2B16, yAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen, 0, PK_B32, maskB32);
                vsts(y3B16, yAddr + offset + (2 * xLoop + 1) * dimLen, 0, PK_B32, maskB32);
                vsts(y4B16, yAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0, PK_B32,
                     maskB32);
            }
            vdup(y1B32, 0, maskB32, MODE_ZEROING);
            vdup(y2B32, 0, maskB32, MODE_ZEROING);
            vlds(x11B16, xAddr + offset + 2 * xLoopNum * dimLen, 0, UNPK_B16);
            vlds(x12B16, xAddr + offset + (2 * xLoopNum + 1) * dimLen, 0, UNPK_B16);
            vlds(x13B16, xAddr + offset + (2 * xLoopNum + 2) * dimLen, 0, UNPK_B16);
            vlds(x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoopNum * dimLen, 0, UNPK_B16);
            vlds(x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 1) * dimLen, 0, UNPK_B16);
            vlds(x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 2) * dimLen, 0, UNPK_B16);
            vcvt(x11B32, x11B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x12B32, x12B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x13B32, x13B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x21B32, x21B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x22B32, x22B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x23B32, x23B16, maskB32, PART_EVEN, MODE_ZEROING);
            vmul(mul11B32, x11B32, weight11B32, maskB32, MODE_ZEROING);
            vmul(mul12B32, x12B32, weight12B32, maskB32, MODE_ZEROING);
            vmul(mul13B32, x13B32, weight13B32, maskB32, MODE_ZEROING);
            vmul(mul21B32, x21B32, weight21B32, maskB32, MODE_ZEROING);
            vmul(mul22B32, x22B32, weight22B32, maskB32, MODE_ZEROING);
            vmul(mul23B32, x23B32, weight23B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, mul11B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, mul12B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, mul13B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, x13B32, maskB32, MODE_ZEROING);
            vadd(y2B32, y2B32, mul21B32, maskB32, MODE_ZEROING);
            vadd(y2B32, y2B32, mul22B32, maskB32, MODE_ZEROING);
            vadd(y2B32, y2B32, mul23B32, maskB32, MODE_ZEROING);
            vadd(y2B32, y2B32, x23B32, maskB32, MODE_ZEROING);
            vcvt(y1B16, y1B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vcvt(y2B16, y2B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(y1B16, yAddr + offset + 2 * xLoopNum * dimLen, 0, PK_B32, maskB32);
            vsts(y2B16, yAddr + offset + B32_REP_SIZE + 2 * xLoopNum * dimLen, 0, PK_B32, maskB32);

            offset += 2 * B32_REP_SIZE;
        }

        uint32_t sreg = dimRem - B32_REP_SIZE;
        maskRem = plt_b32(sreg, POST_UPDATE);
        vlds(weight11B16, weightAddr + offset, 0, UNPK_B16);
        vlds(weight12B16, weightAddr + offset + dimLen, 0, UNPK_B16);
        vlds(weight13B16, weightAddr + offset + 2 * dimLen, 0, UNPK_B16);
        vcvt(weight11B32, weight11B16, maskB32, PART_EVEN, MODE_ZEROING);
        vcvt(weight12B32, weight12B16, maskB32, PART_EVEN, MODE_ZEROING);
        vcvt(weight13B32, weight13B16, maskB32, PART_EVEN, MODE_ZEROING);
        vlds(weight21B16, weightAddr + offset + B32_REP_SIZE, 0, UNPK_B16);
        vlds(weight22B16, weightAddr + offset + B32_REP_SIZE + dimLen, 0, UNPK_B16);
        vlds(weight23B16, weightAddr + offset + B32_REP_SIZE + 2 * dimLen, 0, UNPK_B16);
        vcvt(weight21B32, weight21B16, maskRem, PART_EVEN, MODE_ZEROING);
        vcvt(weight22B32, weight22B16, maskRem, PART_EVEN, MODE_ZEROING);
        vcvt(weight23B32, weight23B16, maskRem, PART_EVEN, MODE_ZEROING);
#pragma unroll 1
        for (uint32_t xLoop = 0; xLoop < xLoopNum; xLoop++) {
            vdup(y1B32, 0, maskB32, MODE_ZEROING);
            vdup(y2B32, 0, maskRem, MODE_ZEROING);
            vdup(y3B32, 0, maskB32, MODE_ZEROING);
            vdup(y4B32, 0, maskRem, MODE_ZEROING);
            vlds(x11B16, xAddr + offset + 2 * xLoop * dimLen, 0, UNPK_B16);
            vlds(x12B16, xAddr + offset + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
            vlds(x13B16, xAddr + offset + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
            vlds(x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoop * dimLen, 0, UNPK_B16);
            vlds(x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
            vlds(x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
            vlds(x31B16, xAddr + offset + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
            vlds(x32B16, xAddr + offset + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
            vlds(x33B16, xAddr + offset + (2 * xLoop + 3) * dimLen, 0, UNPK_B16);
            vlds(x41B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0, UNPK_B16);
            vlds(x42B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 2) * dimLen, 0, UNPK_B16);
            vlds(x43B16, xAddr + offset + B32_REP_SIZE + (2 * xLoop + 3) * dimLen, 0, UNPK_B16);
            vcvt(x11B32, x11B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x12B32, x12B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x13B32, x13B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x21B32, x21B16, maskRem, PART_EVEN, MODE_ZEROING);
            vcvt(x22B32, x22B16, maskRem, PART_EVEN, MODE_ZEROING);
            vcvt(x23B32, x23B16, maskRem, PART_EVEN, MODE_ZEROING);
            vcvt(x31B32, x31B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x32B32, x32B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x33B32, x33B16, maskB32, PART_EVEN, MODE_ZEROING);
            vcvt(x41B32, x41B16, maskRem, PART_EVEN, MODE_ZEROING);
            vcvt(x42B32, x42B16, maskRem, PART_EVEN, MODE_ZEROING);
            vcvt(x43B32, x43B16, maskRem, PART_EVEN, MODE_ZEROING);
            vmul(mul11B32, x11B32, weight11B32, maskB32, MODE_ZEROING);
            vmul(mul12B32, x12B32, weight12B32, maskB32, MODE_ZEROING);
            vmul(mul13B32, x13B32, weight13B32, maskB32, MODE_ZEROING);
            vmul(mul21B32, x21B32, weight21B32, maskRem, MODE_ZEROING);
            vmul(mul22B32, x22B32, weight22B32, maskRem, MODE_ZEROING);
            vmul(mul23B32, x23B32, weight23B32, maskRem, MODE_ZEROING);
            vmul(mul31B32, x31B32, weight11B32, maskB32, MODE_ZEROING);
            vmul(mul32B32, x32B32, weight12B32, maskB32, MODE_ZEROING);
            vmul(mul33B32, x33B32, weight13B32, maskB32, MODE_ZEROING);
            vmul(mul41B32, x41B32, weight21B32, maskRem, MODE_ZEROING);
            vmul(mul42B32, x42B32, weight22B32, maskRem, MODE_ZEROING);
            vmul(mul43B32, x43B32, weight23B32, maskRem, MODE_ZEROING);
            vadd(y1B32, y1B32, mul11B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, mul12B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, mul13B32, maskB32, MODE_ZEROING);
            vadd(y1B32, y1B32, x13B32, maskB32, MODE_ZEROING);
            vadd(y2B32, y2B32, mul21B32, maskRem, MODE_ZEROING);
            vadd(y2B32, y2B32, mul22B32, maskRem, MODE_ZEROING);
            vadd(y2B32, y2B32, mul23B32, maskRem, MODE_ZEROING);
            vadd(y2B32, y2B32, x23B32, maskRem, MODE_ZEROING);
            vadd(y3B32, y3B32, mul31B32, maskB32, MODE_ZEROING);
            vadd(y3B32, y3B32, mul32B32, maskB32, MODE_ZEROING);
            vadd(y3B32, y3B32, mul33B32, maskB32, MODE_ZEROING);
            vadd(y3B32, y3B32, x33B32, maskB32, MODE_ZEROING);
            vadd(y4B32, y4B32, mul41B32, maskRem, MODE_ZEROING);
            vadd(y4B32, y4B32, mul42B32, maskRem, MODE_ZEROING);
            vadd(y4B32, y4B32, mul43B32, maskRem, MODE_ZEROING);
            vadd(y4B32, y4B32, x43B32, maskRem, MODE_ZEROING);
            vcvt(y1B16, y1B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vcvt(y2B16, y2B32, maskRem, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vcvt(y3B16, y3B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vcvt(y4B16, y4B32, maskRem, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
            vsts(y1B16, yAddr + dimLoopNum * B32_REP_SIZE * 2 + 2 * xLoop * dimLen, 0, PK_B32,
                 maskB32);
            vsts(y2B16, yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + 2 * xLoop * dimLen,
                 0, PK_B32, maskRem);
            vsts(y3B16, yAddr + dimLoopNum * B32_REP_SIZE * 2 + (2 * xLoop + 1) * dimLen, 0, PK_B32,
                 maskB32);
            vsts(y4B16,
                 yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + (2 * xLoop + 1) * dimLen, 0,
                 PK_B32, maskRem);
        }
        vdup(y1B32, 0, maskB32, MODE_ZEROING);
        vdup(y2B32, 0, maskRem, MODE_ZEROING);
        vlds(x11B16, xAddr + offset + 2 * xLoopNum * dimLen, 0, UNPK_B16);
        vlds(x12B16, xAddr + offset + (2 * xLoopNum + 1) * dimLen, 0, UNPK_B16);
        vlds(x13B16, xAddr + offset + (2 * xLoopNum + 2) * dimLen, 0, UNPK_B16);
        vlds(x21B16, xAddr + offset + B32_REP_SIZE + 2 * xLoopNum * dimLen, 0, UNPK_B16);
        vlds(x22B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 1) * dimLen, 0, UNPK_B16);
        vlds(x23B16, xAddr + offset + B32_REP_SIZE + (2 * xLoopNum + 2) * dimLen, 0, UNPK_B16);
        vcvt(x11B32, x11B16, maskB32, PART_EVEN, MODE_ZEROING);
        vcvt(x12B32, x12B16, maskB32, PART_EVEN, MODE_ZEROING);
        vcvt(x13B32, x13B16, maskB32, PART_EVEN, MODE_ZEROING);
        vcvt(x21B32, x21B16, maskRem, PART_EVEN, MODE_ZEROING);
        vcvt(x22B32, x22B16, maskRem, PART_EVEN, MODE_ZEROING);
        vcvt(x23B32, x23B16, maskRem, PART_EVEN, MODE_ZEROING);
        vmul(mul11B32, x11B32, weight11B32, maskB32, MODE_ZEROING);
        vmul(mul12B32, x12B32, weight12B32, maskB32, MODE_ZEROING);
        vmul(mul13B32, x13B32, weight13B32, maskB32, MODE_ZEROING);
        vmul(mul21B32, x21B32, weight21B32, maskRem, MODE_ZEROING);
        vmul(mul22B32, x22B32, weight22B32, maskRem, MODE_ZEROING);
        vmul(mul23B32, x23B32, weight23B32, maskRem, MODE_ZEROING);
        vadd(y1B32, y1B32, mul11B32, maskB32, MODE_ZEROING);
        vadd(y1B32, y1B32, mul12B32, maskB32, MODE_ZEROING);
        vadd(y1B32, y1B32, mul13B32, maskB32, MODE_ZEROING);
        vadd(y1B32, y1B32, x13B32, maskB32, MODE_ZEROING);
        vadd(y2B32, y2B32, mul21B32, maskRem, MODE_ZEROING);
        vadd(y2B32, y2B32, mul22B32, maskRem, MODE_ZEROING);
        vadd(y2B32, y2B32, mul23B32, maskRem, MODE_ZEROING);
        vadd(y2B32, y2B32, x23B32, maskRem, MODE_ZEROING);
        vcvt(y1B16, y1B32, maskB32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
        vcvt(y2B16, y2B32, maskRem, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
        vsts(y1B16, yAddr + dimLoopNum * B32_REP_SIZE * 2 + 2 * xLoopNum * dimLen, 0, PK_B32,
             maskB32);
        vsts(y2B16, yAddr + dimLoopNum * B32_REP_SIZE * 2 + B32_REP_SIZE + 2 * xLoopNum * dimLen, 0,
             PK_B32, maskRem);
    }
}
extern "C" __global__ __aicore__ void candidate_kernel(__gm__ uint8_t* input,
                                                       __gm__ uint8_t* output) {
    __ubuf__ half* xAddr = (__ubuf__ half*)get_imm(0);
    __ubuf__ half* weightAddr = (__ubuf__ half*)get_imm(19968);
    __ubuf__ half* yAddr = (__ubuf__ half*)get_imm(21504);
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)get_imm(0), input, 0, 1, 21504, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    candidate_vf(xAddr, weightAddr, yAddr);
    set_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    wait_flag(PIPE_V, PIPE_MTE3, (event_t)0);
    copy_ubuf_to_gm_align_v2(output + 0, (__ubuf__ uint8_t*)yAddr, 0, 1, 18816, 0, 0, 0);
}
